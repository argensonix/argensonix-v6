---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import EyebrowLabel from "../components/ui/EyebrowLabel.astro";

// Stage 1 stub — the filterable projects grid is built in a later stage.
---

<BaseLayout
  title="Projects — Argensonix"
  description="A selection of web, radio, design, tools and small systems built over the years by Argensonix."
>
  <Header activePage="projects" />

  <main id="main-content" class="page theme-light">
    <div class="container page__intro section">
      <EyebrowLabel text="Projects" theme="light" />
      <h1 class="page__title">Things made on purpose</h1>
      <p class="page__lead lead">
        A selection of web, radio, design, tools and small systems built over
        the years.
      </p>
      <p class="page__note">Filter + grid coming in a later stage.</p>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    min-height: 55vh;
  }

  .page__title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-extrabold);
    max-width: 16ch;
  }

  .page__note {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
