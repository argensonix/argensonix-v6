---
import { getCollection } from "astro:content";
import { PROJECT_CATEGORIES } from "../content.config";
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import EyebrowLabel from "../components/ui/EyebrowLabel.astro";
import Tag from "../components/ui/Tag.astro";
import ProjectCard from "../components/ui/ProjectCard.astro";

// Published projects, ordered by the manual `order` key
const entries = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);

// Filter pills: "All" + the shared category list
const filters = ["All", ...PROJECT_CATEGORIES];
const toKey = (value: string) => value.toLowerCase();
---

<BaseLayout
  title="Projects — Argensonix"
  description="A selection of web, radio, design, tools and small systems built over the years by Argensonix."
>
  <Header activePage="projects" />

  <main id="main-content">
    <!-- ── Intro (light neutral) ───────────────────────────── -->
    <section class="projects-intro theme-light">
      <div class="container projects-intro__inner">
        <div class="projects-intro__copy">
          <EyebrowLabel text="Projects" theme="light" />
          <h1 class="projects-intro__title">
            Things made <span class="text-cyan">on purpose</span>
          </h1>
          <p class="projects-intro__lead lead">
            A selection of web, radio, design, tools and small systems built
            over the years.
          </p>
        </div>
        <div class="projects-intro__visual" aria-hidden="true"></div>
      </div>
    </section>

    <!-- ── Filters + grid (light blue) ─────────────────────── -->
    <section class="projects-list theme-light-blue section">
      <div class="container">
        <div
          class="projects-filters"
          role="group"
          aria-label="Filter projects by category"
        >
          {
            filters.map((label, i) => (
              <Tag
                variant="filter"
                label={label}
                active={i === 0}
                data-filter={label === "All" ? "all" : toKey(label)}
              />
            ))
          }
        </div>

        <p class="visually-hidden" aria-live="polite" data-filter-status></p>

        <ul class="projects-grid" role="list">
          {
            entries.map((entry) => (
              <li
                class="projects-grid__item"
                data-categories={entry.data.categories.map(toKey).join(" ")}
              >
                <ProjectCard
                  title={entry.data.title}
                  year={entry.data.year}
                  summary={entry.data.summary}
                  tags={entry.data.tags}
                  thumbnail={entry.data.thumbnail}
                  href={entry.data.href}
                  externalUrl={entry.data.externalUrl}
                  entryType={entry.data.entryType}
                />
              </li>
            ))
          }
        </ul>

        <p class="projects-empty" hidden>No projects in this category yet.</p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script is:inline type="module" data-cfasync="false">
  // Client-side category filter — vanilla JS, no framework.
  //
  // ClientRouter-safe: Astro only re-executes swapped-in scripts whose
  // `type` is exactly "module" or "text/javascript" (see astro/dist/
  // transitions/router.js `runScripts`). Cloudflare Rocket Loader (enabled
  // on this zone) rewrites every `type="module"` it sees to a randomized
  // `type="<hash>-module"` so it can defer execution itself — which makes
  // Astro's re-execution check skip this script on every page fetched via
  // ClientRouter, since the fetched HTML is rewritten the same way. A hard
  // load still works because Rocket Loader's own loader runs the script
  // once, but that run never happens again after a client-side navigation.
  // `data-cfasync="false"` is Cloudflare's documented opt-out: it leaves
  // this tag's `type` alone, so it stays a real `type="module"` that both
  // the browser and Astro's runScripts() recognize. `is:inline` is required
  // to keep that attribute in the output (any custom attribute forces
  // Astro to skip processing this script), which also means no TS syntax
  // here — plain JS only.
  //
  // On top of that: bundled scripts only run once per browser session, so a
  // one-shot setup would stop working after the first view-transition
  // navigation (the DOM is swapped, but the script never re-runs). We
  // re-bind on every `astro:page-load` (fresh DOM each navigation → no
  // stale/orphaned listeners) and guard against double-binding the same
  // rendered instance.
  function initProjectFilters() {
    const filterBar = document.querySelector(".projects-filters");
    // No-op on any page that isn't /projects, or if already wired this render.
    if (!filterBar || filterBar.dataset.filtersReady === "true") return;
    filterBar.dataset.filtersReady = "true";

    const buttons = Array.from(filterBar.querySelectorAll(".tag--filter"));
    const items = Array.from(document.querySelectorAll(".projects-grid__item"));
    const status = document.querySelector("[data-filter-status]");
    const empty = document.querySelector(".projects-empty");

    const applyFilter = (filter) => {
      let visible = 0;
      items.forEach((item) => {
        const categories = (item.dataset.categories || "").split(" ");
        const show = filter === "all" || categories.includes(filter);
        item.hidden = !show;
        if (show) visible += 1;
      });
      if (empty) empty.hidden = visible !== 0;
      if (status) {
        status.textContent = `Showing ${visible} project${visible === 1 ? "" : "s"}`;
      }
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        buttons.forEach((other) => {
          const isActive = other === button;
          other.classList.toggle("is-active", isActive);
          other.setAttribute("aria-pressed", String(isActive));
        });
        applyFilter(button.dataset.filter || "all");
      });
    });
  }

  // `astro:page-load` fires on the first load and after every client-side
  // navigation. The direct call covers the race where this module first
  // executes *after* that event has already fired on a fresh navigation to
  // /projects; the `filtersReady` guard makes the pair idempotent.
  initProjectFilters();
  document.addEventListener("astro:page-load", initProjectFilters);
</script>

<style>
  /* ── Intro ─────────────────────────────────────────────── */
  /* A bit more vertical air than the default section */
  .projects-intro {
    padding-block: clamp(3.5rem, 6vw, 6rem);
  }

  .projects-intro__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-10);
    align-items: center;
  }

  .projects-intro__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .projects-intro__title {
    font-size: clamp(2.75rem, 1.8rem + 3.5vw, 4.75rem);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .projects-intro__lead {
    max-width: 52ch;
  }

  /* Decorative placeholder shape — larger, with a touch more presence */
  .projects-intro__visual {
    width: clamp(180px, 22vw, 300px);
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--text-on-light) 12%, transparent);
  }

  /* ── Filters ───────────────────────────────────────────── */
  .projects-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }

  /* ── Grid ──────────────────────────────────────────────── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--card-gap);
  }

  .projects-empty {
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .projects-intro__inner {
      grid-template-columns: 1fr;
    }

    .projects-intro__visual {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
