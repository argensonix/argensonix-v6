---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Button from "../components/ui/Button.astro";
import EyebrowLabel from "../components/ui/EyebrowLabel.astro";
import ProjectCard from "../components/ui/ProjectCard.astro";
import CtaSection from "../components/sections/CtaSection.astro";

// Home "Selected projects" placeholder data. Kept inline (not wired to the
// content collection) until the home gets its own stage; renders via the
// shared ProjectCard so the projects page and home stay visually in sync.
const placeholderProjects = [
  {
    title: "Blur FM",
    summary: "Independent online radio",
    year: "2011-NOW",
    tags: ["Branding", "Web"],
  },
  {
    title: "nico://run",
    summary: "Running data, built on a Pi",
    year: "2026",
    tags: ["AI", "Web"],
  },
  {
    title: "Aires Pulse",
    summary: "A city, in signals",
    year: "2026",
    tags: ["Branding", "Web"],
  },
];
---

<BaseLayout>
  <Header activePage="home" />

  <main id="main-content">
    <!-- ── Hero (dark) ─────────────────────────────────────── -->
    <section class="hero theme-dark">
      <div class="container hero__inner">
        <div class="hero__copy">
          <h1 class="hero__title">
            A lab for <span class="text-cyan">design,</span><br />
            media <span class="hero__amp">&amp;</span> the web.
          </h1>
          <p class="hero__lead">
            Connecting personal projects, writing, radio, tools and homegrown
            web systems.
          </p>
          <div class="hero__actions">
            <Button label="Explore projects" href="/projects" uppercase />
          </div>
        </div>
        <div class="hero__visual" aria-hidden="true"></div>
      </div>
    </section>

    <!-- ── Manifesto (light blue) ──────────────────────────── -->
    <section class="manifesto theme-light-blue section">
      <div class="container manifesto__inner">
        <EyebrowLabel text="01 — Manifesto" theme="light" />
        <div class="manifesto__body">
          <p class="manifesto__statement">
            Argensonix is where <span class="text-cyan"
              >design, code and media experiments</span
            > come together. A living home for small web projects, personal tools,
            radio systems, writing and digital things built slowly, carefully and
            for real use.
          </p>
          <Button label="See what's inside" href="/projects" variant="link" />
        </div>
      </div>
    </section>

    <!-- ── Selected projects (light neutral) ───────────────── -->
    <section class="selected theme-light section">
      <div class="container">
        <div class="selected__head">
          <div class="selected__heading">
            <EyebrowLabel text="02 — Selected projects" theme="light" />
            <h2 class="selected__title">
              Things made <span class="text-cyan">on purpose</span>
            </h2>
          </div>
          <Button
            label="View all projects"
            href="/projects"
            variant="link"
            uppercase
          />
        </div>

        <ul class="selected__grid" role="list">
          {
            placeholderProjects.map((project) => (
              <li>
                <ProjectCard
                  title={project.title}
                  year={project.year}
                  summary={project.summary}
                  tags={project.tags}
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ── CTA (dark) ──────────────────────────────────────── -->
    <CtaSection />
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────── */
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-8);
    align-items: center;
  }

  .hero__title {
    font-size: var(--text-display);
    font-weight: var(--weight-extrabold);
    line-height: 1.04;
    letter-spacing: var(--tracking-tight);
    /* Explicit <br> controls the two-line break; don't let balance re-wrap */
    text-wrap: normal;
  }

  .hero__amp {
    color: var(--text-on-dark-muted);
  }

  .hero__lead {
    margin-top: var(--space-5);
    max-width: 42ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .hero__actions {
    margin-top: var(--space-6);
  }

  /* Decorative circle placeholder for a future hero graphic */
  .hero__visual {
    justify-self: center;
    width: min(100%, 360px);
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--text-on-dark) 12%, transparent);
  }

  /* ── Manifesto ─────────────────────────────────────────── */
  .manifesto__inner {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  .manifesto__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }

  .manifesto__statement {
    font-size: var(--text-statement);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    max-width: 32ch;
  }

  /* ── Selected projects ─────────────────────────────────── */
  .selected__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .selected__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .selected__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
  }

  .selected__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      display: none;
    }

    .manifesto__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .selected__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .selected__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
