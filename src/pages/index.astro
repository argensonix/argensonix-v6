---
import { getCollection } from "astro:content";
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Button from "../components/ui/Button.astro";
import EyebrowLabel from "../components/ui/EyebrowLabel.astro";
import ProjectCard from "../components/ui/ProjectCard.astro";
import BlogCard from "../components/blog/BlogCard.astro";
import HomeHeroMedia from "../components/home/HomeHeroMedia.astro";
import HomeClosing from "../components/home/HomeClosing.astro";
import { getBlogPosts } from "../lib/blog";

// Home "Selected projects" reuses the same content collection as /projects,
// so copy, tags and links stay in sync. Top 3 featured, by manual order.
const featured = (
  await getCollection("projects", ({ data }) => data.featured && !data.draft)
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// "Notes from the lab" — the three most recent blog posts. Cards link
// INTERNALLY to /blog/{slug}; nico.ar is only a secondary link on the post.
const latestPosts = (await getBlogPosts()).slice(0, 3);
---

<BaseLayout>
  <Header activePage="home" />

  <main id="main-content">
    <!-- ── Hero (dark) ─────────────────────────────────────── -->
    <section class="hero theme-dark section-atmos">
      <div class="container hero__inner">
        <div class="hero__copy">
          <h1 class="hero__title">
            A lab for <span class="text-cyan">design,</span><br />
            media <span class="hero__amp">&amp;</span> the web.
          </h1>
          <p class="hero__lead">
            Connecting personal projects, writing, radio, tools and homegrown
            web systems.
          </p>
          <div class="hero__actions">
            <Button label="Explore projects" href="/projects" uppercase />
          </div>
        </div>
        <HomeHeroMedia />
      </div>
    </section>

    <!-- ── Manifesto (light blue) ──────────────────────────── -->
    <section class="manifesto theme-light-blue section">
      <div class="container manifesto__inner">
        <EyebrowLabel text="01 — Manifesto" theme="light" />
        <div class="manifesto__body">
          <p class="manifesto__statement">
            Argensonix is where <span class="text-cyan"
              >design, code and media experiments</span
            > come together.<br /> A living home for small web projects, radio systems, writing and digital things built with care and
            for real use.
          </p>
          <Button label="See what's inside" href="/projects" variant="link" />
        </div>
      </div>
    </section>

    <!-- ── Selected projects (light neutral) ───────────────── -->
    <section class="selected theme-light section">
      <div class="container">
        <div class="selected__head">
          <div class="selected__heading">
            <EyebrowLabel text="02 — Selected projects" theme="light" />
            <h2 class="selected__title">
              Things made <span class="text-cyan">on purpose</span>
            </h2>
          </div>
          <Button
            label="View all projects"
            href="/projects"
            variant="link"
            uppercase
          />
        </div>

        <ul class="selected__grid" role="list">
          {
            featured.map((entry) => (
              <li>
                <ProjectCard
                  title={entry.data.title}
                  year={entry.data.year}
                  summary={entry.data.summary}
                  tags={entry.data.tags}
                  thumbnail={entry.data.thumbnail}
                  href={entry.data.href}
                  externalUrl={entry.data.externalUrl}
                  entryType={entry.data.entryType}
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ── Behind Argensonix (light blue) ──────────────────── -->
    <section class="about theme-light-blue section">
      <div class="container about__inner">
        <!-- Editorial placeholder for a real portrait: a white mat around an
             unexposed print — cool paper gradient, fine grain, one plate-mark
             arc (the same circle motif as the hero lens and the footer seal).
             Swap the inner span for an <img> (with alt text) once the photo
             exists — the mat stays. -->
        <div class="about__photo" aria-hidden="true">
          <span class="about__photo-inner"></span>
        </div>
        <div class="about__copy">
          <EyebrowLabel text="About" theme="light" />
          <h2 class="about__title">Behind Argensonix</h2>
          <p class="about__lead lead">
            I’m Nicolás Zicarelli, a product designer based in Buenos Aires.
            Argensonix is where I connect design, code, radio, writing,
            open-source tools and self-hosted systems — things I build with
            care and use for real.
          </p>
          <p class="about__lead lead">
            I also run long distances, which has more in common with design
            than it seems: patience, rhythm, iteration and showing up.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Notes from the lab / Blog (dark) ────────────────── -->
    {
      latestPosts.length > 0 && (
        <section class="notes theme-dark section section-atmos">
          <div class="container">
            <div class="notes__head">
              <div class="notes__heading">
                <EyebrowLabel text="03 — Blog" />
                <h2 class="notes__title">Notes from the lab</h2>
                <span class="notes__synced">Synced from nico.ar</span>
              </div>
              <Button
                label="Read the blog"
                href="/blog"
                variant="link"
                uppercase
              />
            </div>

            <ul class="notes__grid" role="list">
              {latestPosts.map((post) => (
                <li>
                  <BlogCard post={post} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

  </main>

  <!-- ── Closing (dark) ────────────────────────────────────── -->
  <!-- Home-only poster close: CTA statement + footer merged into one band.
       Other pages get the compact global Footer only (no large CTA). -->
  <HomeClosing />
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────── */
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem);
    /* Anchor the section bloom out on the video side, so the atmosphere around
       the media bleeds into the masthead instead of stopping at the disc.
       Grid is off here — HomeHeroMedia already carries its own dot texture. */
    --atmos-x: 78%;
    --atmos-y: 45%;
    --atmos-strength: 11%;
    --atmos-grid: 0;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-8);
    align-items: center;
  }

  .hero__title {
    font-size: var(--text-display);
    font-weight: var(--weight-extrabold);
    line-height: 1.04;
    letter-spacing: var(--tracking-tight);
    /* Explicit <br> controls the two-line break; don't let balance re-wrap */
    text-wrap: normal;
  }

  .hero__amp {
    color: var(--text-on-dark-muted);
  }

  .hero__lead {
    margin-top: var(--space-6);
    max-width: 46ch;
    font-size: 1.5rem; /* ~24px — reads clearly under the large hero title */
    line-height: 1.5;
    color: var(--muted);
  }

  .hero__actions {
    margin-top: var(--space-6);
  }

  /* ── Manifesto ─────────────────────────────────────────── */
  .manifesto__inner {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  .manifesto__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }

  .manifesto__statement {
    font-size: var(--text-statement);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    max-width: 32ch;
  }

  /* ── Selected projects ─────────────────────────────────── */
  .selected__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .selected__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .selected__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
  }

  .selected__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--card-gap);
  }

  /* ── Notes from the lab ────────────────────────────────── */
  /* Mirrors the Selected-projects head + grid; sits on the dark tier. */
  .notes {
    /* Bloom tucked into the top-left corner, behind the heading rather than
       under the cards, so it never sits beneath body copy. The texture runs
       below the utility default — at this size it should register as depth,
       not as a grid you can actually resolve. A fainter counter-bloom sits
       behind the far card column so the right half of the band isn't dead
       flat; the vertical wash (dark → dark-2 → dark) returns to --bg-dark at
       both edges, so the seams with About and the CTA stay invisible. */
    --atmos-x: 14%;
    --atmos-y: 8%;
    --atmos-grid: 0.35;
    --atmos-x2: 86%;
    --atmos-y2: 68%;
    --atmos-strength2: 4%;
    background-image: linear-gradient(
      180deg,
      var(--bg-dark) 0%,
      var(--bg-dark-2) 55%,
      var(--bg-dark) 100%
    );
  }

  .notes__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .notes__heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .notes__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
  }

  /* "Synced from nico.ar" pill under the section heading. */
  .notes__synced {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }

  .notes__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--card-gap);
  }

  /* ── Behind Argensonix (About module) ──────────────────── */
  /* A short, human intro — not a CV. Photo placeholder + brief copy. */
  .about__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  /* White mat + hairline: the frame a printed portrait would sit in. */
  .about__photo {
    width: clamp(160px, 20vw, 240px);
    aspect-ratio: 4 / 5;
    padding: var(--space-2);
    border-radius: var(--radius-lg);
    background-color: var(--surface);
    border: 1px solid var(--card-border);
    box-shadow: var(--shadow-card);
  }

  /* Inside the mat: an unexposed print. Cool light falls from the top-right
     onto a paper gradient with a fine grain — abstract and quiet, clearly a
     prepared space rather than a missing image. */
  .about__photo-inner {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: calc(var(--radius-lg) - var(--space-2));
    overflow: hidden;
    background-image:
      radial-gradient(
        85% 70% at 74% 16%,
        color-mix(in srgb, var(--accent-cyan) 14%, transparent),
        transparent 64%
      ),
      radial-gradient(
        color-mix(in srgb, var(--text-on-light) 5%, transparent) 1px,
        transparent 1.4px
      ),
      linear-gradient(
        168deg,
        var(--surface) 0%,
        color-mix(in srgb, var(--bg-light-blue) 70%, var(--surface)) 58%,
        var(--bg-light-blue) 100%
      );
    background-size:
      100% 100%,
      5px 5px,
      100% 100%;
  }

  /* One hairline plate-mark arc sweeping out of the lower-left corner — the
     circle motif of the hero lens, embossed on paper. */
  .about__photo-inner::after {
    content: "";
    position: absolute;
    width: 115%;
    aspect-ratio: 1;
    left: -48%;
    bottom: -52%;
    border: 1px solid color-mix(in srgb, var(--text-on-light) 16%, transparent);
    border-radius: 50%;
  }

  .about__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
  }

  .about__lead {
    max-width: 54ch;
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .manifesto__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .selected__grid,
    .notes__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .about__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 560px) {
    .selected__grid,
    .notes__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
