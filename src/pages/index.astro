---
import { getCollection } from "astro:content";
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Button from "../components/ui/Button.astro";
import EyebrowLabel from "../components/ui/EyebrowLabel.astro";
import ProjectCard from "../components/ui/ProjectCard.astro";
import CtaSection from "../components/sections/CtaSection.astro";
import BlogCard from "../components/blog/BlogCard.astro";
import HomeHeroMedia from "../components/home/HomeHeroMedia.astro";
import { getBlogPosts } from "../lib/blog";

// Home "Selected projects" reuses the same content collection as /projects,
// so copy, tags and links stay in sync. Top 3 featured, by manual order.
const featured = (
  await getCollection("projects", ({ data }) => data.featured && !data.draft)
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

// "Notes from the lab" — the three most recent blog posts. Cards link
// INTERNALLY to /blog/{slug}; nico.ar is only a secondary link on the post.
const latestPosts = (await getBlogPosts()).slice(0, 3);
---

<BaseLayout>
  <Header activePage="home" />

  <main id="main-content">
    <!-- ── Hero (dark) ─────────────────────────────────────── -->
    <section class="hero theme-dark section-atmos">
      <div class="container hero__inner">
        <div class="hero__copy">
          <h1 class="hero__title">
            A lab for <span class="text-cyan">design,</span><br />
            media <span class="hero__amp">&amp;</span> the web.
          </h1>
          <p class="hero__lead">
            Connecting personal projects, writing, radio, tools and homegrown
            web systems.
          </p>
          <div class="hero__actions">
            <Button label="Explore projects" href="/projects" uppercase />
          </div>
        </div>
        <HomeHeroMedia />
      </div>
    </section>

    <!-- ── Manifesto (light blue) ──────────────────────────── -->
    <section class="manifesto theme-light-blue section">
      <div class="container manifesto__inner">
        <EyebrowLabel text="01 — Manifesto" theme="light" />
        <div class="manifesto__body">
          <p class="manifesto__statement">
            Argensonix is where <span class="text-cyan"
              >design, code and media experiments</span
            > come together.<br /> A living home for small web projects, radio systems, writing and digital things built with care and
            for real use.
          </p>
          <Button label="See what's inside" href="/projects" variant="link" />
        </div>
      </div>
    </section>

    <!-- ── Selected projects (light neutral) ───────────────── -->
    <section class="selected theme-light section">
      <div class="container">
        <div class="selected__head">
          <div class="selected__heading">
            <EyebrowLabel text="02 — Selected projects" theme="light" />
            <h2 class="selected__title">
              Things made <span class="text-cyan">on purpose</span>
            </h2>
          </div>
          <Button
            label="View all projects"
            href="/projects"
            variant="link"
            uppercase
          />
        </div>

        <ul class="selected__grid" role="list">
          {
            featured.map((entry) => (
              <li>
                <ProjectCard
                  title={entry.data.title}
                  year={entry.data.year}
                  summary={entry.data.summary}
                  tags={entry.data.tags}
                  thumbnail={entry.data.thumbnail}
                  href={entry.data.href}
                  externalUrl={entry.data.externalUrl}
                  entryType={entry.data.entryType}
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ── Behind Argensonix (light blue) ──────────────────── -->
    <section class="about theme-light-blue section">
      <div class="container about__inner">
        <!-- Placeholder for a personal photo / portrait image. -->
        <div class="about__photo" aria-hidden="true"></div>
        <div class="about__copy">
          <EyebrowLabel text="About" theme="light" />
          <h2 class="about__title">Behind Argensonix</h2>
          <p class="about__lead lead">
            Argensonix is the personal lab of Nicolás Zicarelli, a product
            designer based in Buenos Aires. It connects design, code, radio,
            writing and small web systems built with care and curiosity.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Notes from the lab / Blog (dark) ────────────────── -->
    {
      latestPosts.length > 0 && (
        <section class="notes theme-dark section section-atmos">
          <div class="container">
            <div class="notes__head">
              <div class="notes__heading">
                <EyebrowLabel text="03 — Blog" />
                <h2 class="notes__title">Notes from the lab</h2>
                <span class="notes__synced">Synced from nico.ar</span>
              </div>
              <Button
                label="Read the blog"
                href="/blog"
                variant="link"
                uppercase
              />
            </div>

            <ul class="notes__grid" role="list">
              {latestPosts.map((post) => (
                <li>
                  <BlogCard post={post} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- ── CTA (dark) ──────────────────────────────────────── -->
    <CtaSection />
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────── */
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem);
    /* Anchor the section bloom out on the video side, so the atmosphere around
       the media bleeds into the masthead instead of stopping at the disc.
       Grid is off here — HomeHeroMedia already carries its own dot texture. */
    --atmos-x: 78%;
    --atmos-y: 45%;
    --atmos-grid: 0;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-8);
    align-items: center;
  }

  .hero__title {
    font-size: var(--text-display);
    font-weight: var(--weight-extrabold);
    line-height: 1.04;
    letter-spacing: var(--tracking-tight);
    /* Explicit <br> controls the two-line break; don't let balance re-wrap */
    text-wrap: normal;
  }

  .hero__amp {
    color: var(--text-on-dark-muted);
  }

  .hero__lead {
    margin-top: var(--space-6);
    max-width: 46ch;
    font-size: 1.5rem; /* ~24px — reads clearly under the large hero title */
    line-height: 1.5;
    color: var(--muted);
  }

  .hero__actions {
    margin-top: var(--space-6);
  }

  /* ── Manifesto ─────────────────────────────────────────── */
  .manifesto__inner {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  .manifesto__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }

  .manifesto__statement {
    font-size: var(--text-statement);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    max-width: 32ch;
  }

  /* ── Selected projects ─────────────────────────────────── */
  .selected__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .selected__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .selected__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
  }

  .selected__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--card-gap);
  }

  /* ── Notes from the lab ────────────────────────────────── */
  /* Mirrors the Selected-projects head + grid; sits on the dark tier. */
  .notes {
    /* Bloom tucked into the top-left corner, behind the heading rather than
       under the cards, so it never sits beneath body copy. The texture runs
       below the utility default — at this size it should register as depth,
       not as a grid you can actually resolve. */
    --atmos-x: 14%;
    --atmos-y: 8%;
    --atmos-grid: 0.3;
  }

  .notes__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .notes__heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .notes__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
  }

  /* "Synced from nico.ar" pill under the section heading. */
  .notes__synced {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }

  .notes__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--card-gap);
  }

  /* ── Behind Argensonix (About module) ──────────────────── */
  /* A short, human intro — not a CV. Photo placeholder + brief copy. */
  .about__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .about__photo {
    width: clamp(160px, 20vw, 240px);
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    background-color: color-mix(in srgb, var(--text-on-light) 12%, transparent);
    border: 1px solid var(--card-border);
  }

  .about__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about__title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
  }

  .about__lead {
    max-width: 54ch;
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .manifesto__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .selected__grid,
    .notes__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .about__inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 560px) {
    .selected__grid,
    .notes__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
