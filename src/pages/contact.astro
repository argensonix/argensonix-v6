---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import EyebrowLabel from "../components/ui/EyebrowLabel.astro";

// Stage 1 stub — the full contact page is built in a later stage.
---

<BaseLayout
  title="Contact — Argensonix"
  description="Get in touch with Argensonix — design, code and media for thoughtful digital projects. Buenos Aires."
>
  <Header activePage="contact" />

  <main id="main-content" class="page theme-light">
    <div class="container page__intro section">
      <EyebrowLabel text="Contact" theme="light" />
      <h1 class="page__title">Let&rsquo;s work together.</h1>
      <p class="page__lead lead">
        Got a project in mind? Design, code and media for thoughtful digital
        projects.
      </p>
      <a class="page__email" href="mailto:nico@argensonix.com.ar">
        nico@argensonix.com.ar
      </a>
      <p class="page__note">Full page coming in a later stage.</p>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    min-height: 55vh;
  }

  .page__title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-extrabold);
    max-width: 16ch;
  }

  .page__email {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    color: var(--accent-cyan);
    transition: color var(--transition);
  }

  .page__email:hover {
    color: var(--accent-cyan-hover);
  }

  .page__note {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
