---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Button from "../../components/ui/Button.astro";
import { getBlogPosts, type BlogPost } from "../../lib/blog";

// One static page per published WordPress post.
export const getStaticPaths = (async () => {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Strip inline tags from the sanitized title for <title>/description meta.
const plainTitle = post.titleHtml.replace(/<[^>]+>/g, "");
const metaDescription =
  post.excerptHtml.replace(/<[^>]+>/g, "").trim().slice(0, 160) ||
  `${plainTitle} — from the Argensonix blog.`;
---

<BaseLayout
  title={`${plainTitle} — Argensonix Blog`}
  description={metaDescription}
  canonical={post.sourceUrl}
  ogImage={post.image ?? "/img/og-default.png"}
>
  <Header activePage="blog" />

  <main id="main-content">
    <article class="post">
      <!-- ── Post header (dark) ────────────────────────────── -->
      <header class="post-hero theme-dark">
        <div class="container">
          <div class="post__col">
            <a class="post-hero__back" href="/blog">&larr; Blog</a>
            <div class="post-hero__meta">
              <time datetime={post.isoDate}>{post.displayDate}</time>
              {post.terms.length > 0 && (
                <span class="post-hero__cats">{post.terms.join(" · ")}</span>
              )}
              <span class="post-hero__synced">Synced from nico.ar</span>
            </div>
            <h1 class="post-hero__title" set:html={post.titleHtml} />
          </div>
        </div>
      </header>

      {
        post.image && (
          <div class="post-figure theme-dark">
            <div class="container">
              <figure class="post__media">
                <img
                  class="post__media-img"
                  src={post.image}
                  alt={post.imageAlt || plainTitle}
                  loading="eager"
                  decoding="async"
                />
              </figure>
            </div>
          </div>
        )
      }

      <!-- ── Post body (light) ─────────────────────────────── -->
      <div class="post-body theme-light section">
        <div class="container">
          <div class="post__col">
            <div class="prose" set:html={post.contentHtml} />

            <footer class="post-foot">
              <p class="post-foot__note">
                Originally published on <span class="post-foot__site">nico.ar</span>.
              </p>
              <Button
                label="Read on nico.ar"
                href={post.sourceUrl}
                variant="link"
                target="_blank"
                rel="noopener noreferrer"
              />
            </footer>
          </div>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Shared, centered reading column. The hero copy, the featured image and the
     body all sit on the same centre axis, so nothing drifts out of alignment.
     Reading measure ~68ch (within the 65–72ch comfortable range). */
  .post__col {
    max-width: 68ch;
    margin-inline: auto;
  }

  /* ── Post header ───────────────────────────────────────── */
  .post-hero {
    padding-block: clamp(3rem, 6vw, 5.5rem) clamp(2rem, 4vw, 3.5rem);
  }

  .post-hero__back {
    display: inline-block;
    margin-bottom: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--accent-cyan);
    transition: color var(--transition);
  }

  .post-hero__back:hover {
    color: var(--accent-cyan-hover);
  }

  .post-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Small "Synced from nico.ar" pill. */
  .post-hero__synced {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
  }

  .post-hero__title {
    font-size: clamp(2.25rem, 1.4rem + 3.2vw, 3.5rem);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  /* ── Featured image ────────────────────────────────────── */
  .post-figure {
    /* Sits between the dark hero and the light body; keep it on the dark tier
       so the image reads as part of the header block. */
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }

  /* Allowed a touch wider than the reading column for a little visual weight,
     but still centred on the same axis. */
  .post__media {
    max-width: 54rem;
    margin-inline: auto;
  }

  /* Natural aspect ratio: never cropped, never stretched. */
  .post__media-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--card-border);
  }

  /* ── Prose (sanitized WordPress HTML) ──────────────────── */
  .prose {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--fg);
  }

  .prose :global(> * + *) {
    margin-top: var(--space-5);
  }

  .prose :global(h2) {
    margin-top: var(--space-10);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
  }

  .prose :global(h3) {
    margin-top: var(--space-8);
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
  }

  .prose :global(h4) {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .prose :global(a) {
    color: var(--accent-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .prose :global(a:hover) {
    color: var(--accent-cyan-hover);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-6);
  }

  .prose :global(li) {
    margin-top: var(--space-2);
  }

  /* Body images: fit the column, keep their real proportions, never crop or
     stretch. Small images stay their own size (left-aligned); wide ones fill
     the measure. */
  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--card-border);
  }

  .prose :global(figure) {
    margin-block: var(--space-6);
  }

  /* Figures may run a little wider than the text for images that deserve it,
     while staying centred and undistorted. */
  .prose :global(figure img) {
    width: 100%;
  }

  .prose :global(figcaption) {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
    text-align: center;
  }

  .prose :global(blockquote) {
    padding-left: var(--space-5);
    border-left: 3px solid var(--accent-cyan);
    color: var(--muted);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .prose :global(pre) {
    padding: var(--space-5);
    border-radius: var(--radius);
    background-color: var(--bg-dark);
    color: var(--text-on-dark);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  /* Inline code (not inside a <pre>) gets a subtle chip. */
  .prose :global(:not(pre) > code) {
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    background-color: color-mix(in srgb, var(--text-on-light) 8%, transparent);
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin-block: var(--space-8);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-3);
    border: 1px solid var(--rule);
    text-align: left;
  }

  .prose :global(iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
    border-radius: var(--radius);
  }

  /* ── Article footer ────────────────────────────────────── */
  .post-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--rule);
  }

  .post-foot__note {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
  }

  .post-foot__site {
    color: var(--fg);
  }
</style>
