---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const disciplines = [
  { label: "Web Design & Development", years: "25+" },
  { label: "Animation & Motion", years: "15+" },
  { label: "Graphic Design", years: "25+" },
  { label: "Logo & Brand Identity", years: "20+" },
  { label: "Audio & Video Production", years: "15+" },
];

const values = [
  {
    number: "01",
    title: "Curiosity first",
    body: "Every project starts with a genuine question. Why does this exist? Who needs it? What would make it memorable? Curiosity is the engine.",
  },
  {
    number: "02",
    title: "Craft over speed",
    body: "Details matter. Typography, spacing, color — none of it is accidental. Good design is the result of many small decisions made with care.",
  },
  {
    number: "03",
    title: "Simple, not simplistic",
    body: "Removing complexity is harder than adding it. The goal is always clarity: the clearest path from intent to outcome.",
  },
];

const milestones = [
  { year: "1999", label: "Argensonix founded in Salto, Argentina." },
  { year: "2003", label: "First web projects — portfolio sites and small businesses." },
  { year: "2008", label: "Expanded into animation and motion graphics." },
  { year: "2012", label: "Blur FM — online radio brand and web platform." },
  { year: "2016", label: "Moved to Buenos Aires. Started working with international clients." },
  { year: "2020", label: "Product design focus. Enterprise UX and design systems." },
  { year: "2025", label: "Still building. Still learning." },
];
---

<BaseLayout
  title="About — Argensonix"
  description="Nicolás Zicarelli is a multimedia designer and product designer based in Buenos Aires. Argensonix since 1999."
>
  <SiteHeader />

  <main id="main-content">

    <!-- ── 1. Hero ─────────────────────────────────────────── -->
    <section class="about-hero">
      <div class="container about-hero__inner">
        <div class="about-hero__text">
          <span class="eyebrow">About</span>
          <h1 class="about-hero__headline h-display">
            Design,<br />
            <em class="about-hero__em">curiosity</em><br />
            and craft.
          </h1>
        </div>
        <div class="about-hero__lead-col">
          <p class="lead">
            Argensonix is the creative studio of Nicolás Zicarelli — a
            multimedia designer and product designer based in Buenos Aires,
            Argentina. For more than 25 years, the studio has worked across
            web, animation, brand identity, and multimedia production.
          </p>
          <p class="about-hero__sub">
            From an ecology portal to an online radio station, all projects
            share the same spirit: passion to do and learn.
          </p>
        </div>
      </div>
    </section>

    <!-- ── 2. Photo + Bio ──────────────────────────────────── -->
    <section class="about-bio section">
      <div class="container about-bio__inner">

        <div class="about-bio__image-col">
          <!-- Replace with real portrait photo -->
          <div class="img-placeholder img-placeholder--portrait" aria-hidden="true">
            <span class="img-placeholder__label">Portrait</span>
          </div>
          <div class="about-bio__image-caption">
            Nicolás Zicarelli — Buenos Aires, 2025
          </div>
        </div>

        <div class="about-bio__text-col">
          <span class="eyebrow">The person</span>
          <h2 class="about-bio__title h-lg">
            Powered by the<br /> .COM wave since 1999.
          </h2>
          <div class="about-bio__body">
            <p>
              As a kid, I built pretend antennas on my rooftop, sketched slides
              and designed greeting cards in Microsoft Publisher. I even kept a
              notebook of every URL I discovered. In 1999, a magazine article
              about the ".com boom" inspired me to launch Argensonix, my own
              multimedia playground.
            </p>
            <p>
              I specialize in web design, corporate identity and multimedia
              production. I'm driven by curiosity and projects that keep me
              motivated and eager to learn every day.
            </p>
            <p>
              Currently working as a Product Designer at Ipsos Interactive
              Services, designing research tools used by global teams.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- ── 3. Disciplines ─────────────────────────────────── -->
    <section class="about-disciplines section section--sm">
      <div class="container">
        <div class="about-disciplines__header">
          <span class="eyebrow">What I do</span>
          <h2 class="h-lg about-disciplines__title">Five disciplines,<br />one studio.</h2>
        </div>
        <ul class="about-disciplines__list" role="list">
          {disciplines.map((d, i) => (
            <li class="discipline-item">
              <span class="discipline-item__index">0{i + 1}</span>
              <span class="discipline-item__label">{d.label}</span>
              <span class="discipline-item__years">{d.years} yrs</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ── 4. Values ──────────────────────────────────────── -->
    <section class="about-values section">
      <div class="container">
        <span class="eyebrow">How I work</span>
        <h2 class="h-lg about-values__title">Three principles.</h2>
        <div class="about-values__grid">
          {values.map((v) => (
            <div class="value-card">
              <span class="value-card__number">{v.number}</span>
              <h3 class="value-card__title">{v.title}</h3>
              <p class="value-card__body">{v.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 5. Studio images ───────────────────────────────── -->
    <section class="about-gallery section section--sm">
      <div class="container">
        <span class="eyebrow">The studio</span>
        <div class="about-gallery__grid">
          <div class="img-placeholder img-placeholder--wide" aria-hidden="true">
            <span class="img-placeholder__label">Studio / workspace</span>
          </div>
          <div class="about-gallery__side">
            <div class="img-placeholder img-placeholder--square" aria-hidden="true">
              <span class="img-placeholder__label">Detail</span>
            </div>
            <div class="img-placeholder img-placeholder--square" aria-hidden="true">
              <span class="img-placeholder__label">Process</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 6. Timeline ────────────────────────────────────── -->
    <section class="about-timeline section">
      <div class="container about-timeline__inner">
        <div class="about-timeline__header">
          <span class="eyebrow">History</span>
          <h2 class="h-lg about-timeline__title">25 years<br />in motion.</h2>
        </div>
        <ol class="timeline" role="list">
          {milestones.map((m) => (
            <li class="timeline__item">
              <span class="timeline__year">{m.year}</span>
              <span class="timeline__dot" aria-hidden="true"></span>
              <p class="timeline__label">{m.label}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── 7. CTA ─────────────────────────────────────────── -->
    <section class="about-cta section section--sm">
      <div class="container about-cta__inner">
        <div>
          <h2 class="h-xl about-cta__title">Want to work together?</h2>
          <p class="lead about-cta__sub">Let's talk about your next project.</p>
        </div>
        <div class="about-cta__actions">
          <a href="/work" class="btn btn--outline">See the work</a>
          <a href="/contact" class="btn btn--primary">Get in touch</a>
        </div>
      </div>
    </section>

  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────── */
  .about-hero {
    background: var(--surface);
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
    border-bottom: 1px solid var(--line);
  }

  .about-hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: end;
  }

  .about-hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about-hero__headline {
    color: var(--dark-blue);
  }

  .about-hero__em {
    font-style: normal;
    color: var(--brand-blue);
  }

  .about-hero__lead-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .about-hero__sub {
    color: var(--ink-muted);
    font-size: var(--text-base);
    line-height: 1.7;
    border-left: 3px solid var(--brand-blue);
    padding-left: var(--space-4);
  }

  /* ── Image placeholders ─────────────────────────────────── */
  .img-placeholder {
    background: var(--surface-alt);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .img-placeholder::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 12px,
      rgba(0, 183, 255, 0.04) 12px,
      rgba(0, 183, 255, 0.04) 13px
    );
  }

  .img-placeholder__label {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: var(--surface);
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--line-strong);
  }

  .img-placeholder--portrait {
    aspect-ratio: 3 / 4;
    width: 100%;
  }

  .img-placeholder--wide {
    aspect-ratio: 16 / 9;
    width: 100%;
  }

  .img-placeholder--square {
    aspect-ratio: 1;
    width: 100%;
  }

  /* ── Bio ─────────────────────────────────────────────────── */
  .about-bio {
    background: var(--bg);
  }

  .about-bio__inner {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  .about-bio__image-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    position: sticky;
    top: calc(96px + var(--space-8));
  }

  .about-bio__image-caption {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    text-align: center;
  }

  .about-bio__text-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about-bio__title {
    color: var(--dark-blue);
  }

  .about-bio__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about-bio__body p {
    color: var(--ink-muted);
    line-height: 1.8;
    font-size: var(--text-md);
  }

  /* ── Disciplines ─────────────────────────────────────────── */
  .about-disciplines {
    background: var(--surface);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .about-disciplines__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-10);
  }

  .about-disciplines__title {
    color: var(--dark-blue);
  }

  .about-disciplines__list {
    display: flex;
    flex-direction: column;
  }

  .discipline-item {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--line);
    transition: color var(--transition);
  }

  .discipline-item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .discipline-item__index {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--ink-soft);
  }

  .discipline-item__label {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--ink);
  }

  .discipline-item__years {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--brand-blue);
    white-space: nowrap;
  }

  /* ── Values ──────────────────────────────────────────────── */
  .about-values {
    background: var(--dark-blue);
    color: var(--ink-on-brand);
  }

  .about-values .eyebrow {
    color: var(--brand-blue);
  }

  .about-values__title {
    color: #ffffff;
    margin-top: var(--space-2);
    margin-bottom: var(--space-12);
  }

  .about-values__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  .value-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.04);
  }

  .value-card__number {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--brand-blue);
  }

  .value-card__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: #ffffff;
  }

  .value-card__body {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.7;
  }

  /* ── Gallery ─────────────────────────────────────────────── */
  .about-gallery {
    background: var(--bg);
  }

  .about-gallery .eyebrow {
    display: block;
    margin-bottom: var(--space-6);
  }

  .about-gallery__grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-4);
    align-items: stretch;
  }

  .about-gallery__side {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: var(--space-4);
  }

  /* ── Timeline ────────────────────────────────────────────── */
  .about-timeline {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }

  .about-timeline__inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  .about-timeline__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    position: sticky;
    top: calc(96px + var(--space-8));
  }

  .about-timeline__title {
    color: var(--dark-blue);
  }

  .timeline {
    display: flex;
    flex-direction: column;
    position: relative;
    padding-left: var(--space-8);
  }

  /* Vertical line */
  .timeline::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--line-strong);
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-5) 0;
    position: relative;
  }

  /* Dot on the line */
  .timeline__dot {
    position: absolute;
    left: calc(-1 * var(--space-8) + 1px);
    top: 50%;
    transform: translateY(-50%);
    width: 14px;
    height: 14px;
    background: var(--surface);
    border: 2px solid var(--brand-blue);
    border-radius: 50%;
  }

  .timeline__item:first-child .timeline__dot {
    background: var(--brand-blue);
  }

  .timeline__item:last-child .timeline__dot {
    background: var(--brand-blue);
  }

  .timeline__year {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--brand-blue);
    white-space: nowrap;
  }

  .timeline__label {
    font-size: var(--text-base);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  /* ── CTA ─────────────────────────────────────────────────── */
  .about-cta {
    border-top: 1px solid var(--line);
    background: var(--bg);
  }

  .about-cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .about-cta__title {
    color: var(--dark-blue);
    margin-bottom: var(--space-2);
  }

  .about-cta__sub {
    font-size: var(--text-base);
  }

  .about-cta__actions {
    display: flex;
    gap: var(--space-4);
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 960px) {
    .about-hero__inner,
    .about-bio__inner,
    .about-timeline__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .about-bio__image-col {
      position: static;
      max-width: 360px;
    }

    .about-timeline__header {
      position: static;
    }

    .about-gallery__grid {
      grid-template-columns: 1fr;
    }

    .about-gallery__side {
      grid-template-rows: auto;
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .about-values__grid {
      grid-template-columns: 1fr;
    }

    .about-cta__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 560px) {
    .discipline-item {
      grid-template-columns: 32px 1fr;
    }

    .discipline-item__years {
      display: none;
    }
  }
</style>
