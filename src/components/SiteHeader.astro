---
const navLinks = [
  { label: "About", href: "/about" },
  { label: "Work", href: "/work" },
  { label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" role="banner">
  <div class="site-header__inner container">

    <!-- Logo -->
    <a href="/" class="site-header__logo" aria-label="Argensonix — home">
      <img
        src="/img/logo.svg"
        alt="Argensonix"
        width="221"
        height="60"
        loading="eager"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="site-nav" aria-label="Primary navigation">
      <ul class="site-nav__list" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "site-nav__link",
                { "site-nav__link--active": currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)) }
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile nav toggle (JS-controlled, proper ARIA) -->
    <button
      type="button"
      class="nav-toggle"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>

    <!-- Mobile nav drawer -->
    <nav id="mobile-nav" class="site-nav--mobile" aria-label="Mobile navigation" hidden>
      <ul class="site-nav--mobile__list" role="list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="site-nav--mobile__link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const mobileNav = document.getElementById("mobile-nav");

  // Backdrop blur when page is scrolled
  if (header) {
    const onScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 10);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll(); // run once on load in case page is already scrolled
  }

  // Mobile nav toggle
  if (toggle && mobileNav) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", isOpen ? "false" : "true");
      toggle.classList.toggle("nav-toggle--open", !isOpen);
      if (isOpen) {
        // Close: first remove open class for CSS transition, then hide after transition
        mobileNav.classList.remove("nav-open");
        mobileNav.addEventListener("transitionend", () => {
          mobileNav.hidden = true;
        }, { once: true });
      } else {
        // Open: unhide first, then add open class to trigger transition
        mobileNav.hidden = false;
        // Force reflow so the transition actually runs
        mobileNav.getBoundingClientRect();
        mobileNav.classList.add("nav-open");
      }
    });

    // Close when any mobile nav link is clicked
    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        toggle.setAttribute("aria-expanded", "false");
        toggle.classList.remove("nav-toggle--open");
        mobileNav.classList.remove("nav-open");
        mobileNav.addEventListener("transitionend", () => {
          mobileNav.hidden = true;
        }, { once: true });
      });
    });
  }
</script>

<style>
  /* ---- Header shell ---- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--brand-blue);
    /* No border-bottom here — the hero section handles its own top treatment */
    transition: background var(--transition), backdrop-filter var(--transition), box-shadow var(--transition);
  }

  /* Subtle depth when page is scrolled (backdrop blur requires semi-transparent bg) */
  .site-header.is-scrolled {
    background: rgba(0, 183, 255, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 20px rgba(0, 0, 0, 0.12);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    position: relative;
  }

  /* ---- Logo ---- */
  .site-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-header__logo img {
    /* Logo SVG uses white fill — matches the blue header */
    height: 44px;
    width: auto;
  }

  /* ---- Desktop nav ---- */
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .site-nav__link {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    padding: var(--space-2) 0;
    border-bottom: 2px solid transparent;
    transition: color var(--transition), border-color var(--transition);
  }

  .site-nav__link:hover,
  .site-nav__link--active {
    color: #ffffff;
    border-bottom-color: rgba(255, 255, 255, 0.7);
  }

  /* ---- Mobile toggle button ---- */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 6px;
    border-radius: var(--radius);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background var(--transition);
  }

  .nav-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .nav-toggle__bar {
    display: block;
    width: 100%;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: transform var(--transition), opacity var(--transition);
    transform-origin: center;
  }

  /* Animate bars to X when open */
  .nav-toggle--open .nav-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle--open .nav-toggle__bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .nav-toggle--open .nav-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---- Mobile nav drawer ---- */
  .site-nav--mobile {
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    background: var(--brand-blue-dark);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 99;
    /* Slide-in transition — starts collapsed, expands on .nav-open */
    overflow: hidden;
    max-height: 0;
    transition: max-height 260ms var(--ease);
  }

  /* hidden attribute hides it; this controls the shown + animated state */
  .site-nav--mobile:not([hidden]) {
    /* visible but not yet open — max-height still 0 until .nav-open */
    max-height: 0;
  }

  .site-nav--mobile.nav-open {
    max-height: 400px;
  }

  .site-nav--mobile__list {
    display: flex;
    flex-direction: column;
    padding: var(--space-4) 0;
  }

  .site-nav--mobile__link {
    display: block;
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    transition: background var(--transition), color var(--transition);
  }

  .site-nav--mobile__link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .site-nav {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }
  }
</style>
