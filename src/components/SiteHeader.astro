---
const navLinks = [
  { label: "About", href: "/about" },
  { label: "Work", href: "/work" },
  { label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" role="banner">
  <div class="site-header__inner container">

    <!-- Logo -->
    <a href="/" class="site-header__logo" aria-label="Argensonix — home">
      <img
        src="/img/logo.svg"
        alt="Argensonix"
        width="221"
        height="60"
        loading="eager"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="site-nav" aria-label="Primary navigation">
      <ul class="site-nav__list" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "site-nav__link",
                { "site-nav__link--active": currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)) }
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile nav toggle (CSS-only via checkbox) -->
    <label class="nav-toggle" for="nav-toggle" aria-label="Toggle navigation">
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </label>
    <input type="checkbox" id="nav-toggle" class="nav-toggle__input" aria-hidden="true" />

    <!-- Mobile nav drawer -->
    <nav class="site-nav--mobile" aria-label="Mobile navigation">
      <ul class="site-nav--mobile__list" role="list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="site-nav--mobile__link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

  </div>
</header>

<style>
  /* ---- Header shell ---- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--brand-blue);
    border-bottom: 1px solid var(--brand-blue-dark);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 96px;
    position: relative;
  }

  /* ---- Logo ---- */
  .site-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-header__logo img {
    height: 60px;
    width: auto;
  }

  /* ---- Desktop nav ---- */
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .site-nav__link {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    padding: var(--space-2) 0;
    border-bottom: 2px solid transparent;
    transition: color var(--transition), border-color var(--transition);
  }

  .site-nav__link:hover,
  .site-nav__link--active {
    color: #ffffff;
    border-bottom-color: rgba(255, 255, 255, 0.7);
  }

  /* ---- Mobile toggle ---- */
  .nav-toggle__input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    cursor: pointer;
    padding: 6px;
    border-radius: var(--radius);
    transition: background var(--transition);
  }

  .nav-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .nav-toggle__bar {
    display: block;
    width: 100%;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: transform var(--transition), opacity var(--transition);
  }

  /* Animate toggle bars when open */
  .nav-toggle__input:checked ~ .site-header__inner .nav-toggle .nav-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle__input:checked ~ .site-header__inner .nav-toggle .nav-toggle__bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle__input:checked ~ .site-header__inner .nav-toggle .nav-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---- Mobile nav drawer ---- */
  .site-nav--mobile {
    display: none;
    position: absolute;
    top: 96px;
    left: 0;
    right: 0;
    background: var(--brand-blue-dark);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 99;
  }

  .site-nav--mobile__list {
    display: flex;
    flex-direction: column;
    padding: var(--space-4) 0;
  }

  .site-nav--mobile__link {
    display: block;
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    transition: background var(--transition), color var(--transition);
  }

  .site-nav--mobile__link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .site-nav {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }

    /* Show mobile nav when checkbox is checked */
    .nav-toggle__input:checked + .site-nav--mobile {
      display: block;
    }
  }
</style>
