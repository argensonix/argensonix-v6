---
/**
 * Footer — dark band: logo + nav + social icons, hairline, copyright strip.
 * Copyright / version use JetBrains Mono per the type rules.
 *
 * NOTE: the GitHub URL is a placeholder — confirm the real handle.
 */
const navLinks = [
  { label: "About", href: "/about" },
  { label: "Projects", href: "/projects" },
  { label: "Contact", href: "/contact" },
];

const socialLinks = [
  { label: "GitHub", href: "https://github.com/argensonix", icon: "github" },
  {
    label: "LinkedIn",
    href: "https://ar.linkedin.com/in/nicolaszicarelli/",
    icon: "linkedin",
  },
  { label: "Email", href: "mailto:nico@argensonix.com.ar", icon: "email" },
];
---

<footer class="footer theme-dark">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__logo" href="/" aria-label="Argensonix — home">
          <img src="/img/logo.svg" alt="Argensonix" width="236" height="64" />
        </a>

        <nav class="footer__nav" aria-label="Footer">
          <ul class="footer__nav-list" role="list">
            {
              navLinks.map((link) => (
                <li>
                  <a class="footer__nav-link" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <ul class="footer__social" role="list">
        {
          socialLinks.map((link) => {
            const external = link.href.startsWith("http");
            return (
              <li>
                <a
                  class="footer__social-link"
                  href={link.href}
                  aria-label={link.label}
                  {...(external
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  {link.icon === "github" && (
                    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.16-.02-2.1-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"
                      />
                    </svg>
                  )}
                  {link.icon === "linkedin" && (
                    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                      />
                    </svg>
                  )}
                  {link.icon === "email" && (
                    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M2 5.5C2 4.67 2.67 4 3.5 4h17c.83 0 1.5.67 1.5 1.5v13c0 .83-.67 1.5-1.5 1.5h-17C2.67 20 2 19.33 2 18.5v-13Zm2.2.5L12 11.6 19.8 6H4.2ZM20 7.3l-7.4 5.3a1 1 0 0 1-1.2 0L4 7.3V18h16V7.3Z"
                      />
                    </svg>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    <hr class="footer__rule" />

    <div class="footer__bottom">
      <p class="footer__copy">&copy; 1999&ndash;2026 Argensonix Multimedia</p>
      <p class="footer__meta">Made in Buenos Aires &middot; v6.0</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-10) var(--space-6);
  }

  .footer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding-bottom: var(--space-6);
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .footer__logo img {
    height: 54px;
    width: auto;
  }

  .footer__nav-list {
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .footer__nav-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    transition: color var(--transition);
  }

  .footer__nav-link:hover {
    color: var(--text-on-dark);
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .footer__social-link {
    display: inline-flex;
    color: var(--text-on-dark-muted);
    transition: color var(--transition);
  }

  .footer__social-link:hover {
    color: var(--accent-cyan);
  }

  .footer__rule {
    border: 0;
    border-top: 1px solid var(--border-dark);
    margin-block: 0 var(--space-5);
  }

  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer__copy,
  .footer__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--text-on-dark-muted);
  }

  @media (max-width: 560px) {
    .footer__top {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
