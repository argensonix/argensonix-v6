---
/**
 * Header — sticky dark navigation bar.
 *
 * Desktop layout is a three-zone grid: brand (left) · nav (centered) ·
 * Blur FM "ON AIR" pill (right). On mobile the nav + pill collapse and the
 * right zone shows the hamburger; the mobile menu carries a "Listen to Blur FM"
 * row so audio is reachable before the bottom mini-player exists.
 *
 * `activePage` marks the current nav item with a cyan underline + aria-current.
 */
import BlurFmPill from "../blur-fm/BlurFmPill.astro";
import PlayPauseGlyph from "../blur-fm/PlayPauseGlyph.astro";

interface Props {
  activePage?: "home" | "about" | "projects" | "contact";
}

const { activePage = "home" } = Astro.props;

const navLinks = [
  { key: "about", label: "About", href: "/about" },
  { key: "projects", label: "Projects", href: "/projects" },
  { key: "contact", label: "Contact", href: "/contact" },
] as const;
---

<header class="header theme-dark">
  <div class="header__inner container">
    <a class="header__logo" href="/" aria-label="Argensonix — home">
      <img src="/img/logo.svg" alt="Argensonix" width="236" height="64" />
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul class="header__list" role="list">
        {
          navLinks.map((link) => (
            <li>
              <a
                class="nav__link"
                href={link.href}
                aria-current={activePage === link.key ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__right">
      <BlurFmPill />

      <button
        class="header__toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" hidden>
    <ul class="mobile-nav__list container" role="list">
      {
        navLinks.map((link) => (
          <li>
            <a
              class="mobile-nav__link"
              href={link.href}
              aria-current={activePage === link.key ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <button
          class="mobile-nav__listen"
          type="button"
          data-blurfm-toggle
          data-state="paused"
          aria-pressed="false"
          aria-label="Play Blur FM"
        >
          <span class="mobile-nav__listen-glyph"><PlayPauseGlyph size={16} /></span>
          <span class="mobile-nav__listen-label">
            <span class="mobile-nav__listen-dot" aria-hidden="true"></span>
            Listen to Blur FM
          </span>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  // ClientRouter-safe: re-bind the toggle on every page load (the header is
  // re-rendered on navigation, so listeners must be re-attached). The Escape
  // handler is document-scoped and added once.
  function initNav() {
    const toggle =
      document.querySelector<HTMLButtonElement>(".header__toggle");
    const mobileNav = document.getElementById("mobile-nav");
    if (!toggle || !mobileNav) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      toggle.classList.toggle("is-open", open);
      mobileNav.hidden = !open;
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    // Close the menu on nav-link tap (but keep it open for the Listen button).
    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
  }

  document.addEventListener("astro:page-load", initNav);

  // Single Escape handler — closes whichever menu is currently open.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const toggle = document.querySelector<HTMLButtonElement>(".header__toggle");
    const mobileNav = document.getElementById("mobile-nav");
    if (toggle?.getAttribute("aria-expanded") === "true" && mobileNav) {
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Open menu");
      toggle.classList.remove("is-open");
      mobileNav.hidden = true;
    }
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--border-dark);
    /* Background comes from .theme-dark (solid) — unchanged from before. */
  }

  .header__inner {
    display: grid;
    /* Equal side columns keep the centered nav aligned to the viewport,
       independent of the brand and pill widths. */
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-height);
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    justify-self: start;
  }

  .header__logo img {
    height: 54px;
    width: auto;
  }

  /* Centered primary nav. */
  .header__nav {
    justify-self: center;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  /* Nav is Geist Sans per the type rules; uppercased visually only */
  .nav__link {
    display: inline-flex;
    padding-block: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    transition: color var(--transition);
  }

  .nav__link:hover {
    color: var(--text-on-dark);
  }

  .nav__link[aria-current="page"] {
    color: var(--text-on-dark);
    text-decoration: underline;
    text-decoration-color: var(--accent-cyan);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }

  /* Right zone: ON AIR pill (desktop) + hamburger (mobile). */
  .header__right {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Hamburger — hidden on desktop */
  .header__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-sm);
  }

  .header__toggle span {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background-color: var(--text-on-dark);
    transition:
      transform var(--transition),
      opacity var(--transition);
  }

  .header__toggle.is-open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__toggle.is-open span:nth-child(2) {
    opacity: 0;
  }

  .header__toggle.is-open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav {
    border-top: 1px solid var(--border-dark);
    background-color: var(--bg-dark);
  }

  .mobile-nav__list {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-3);
  }

  .mobile-nav__link {
    display: block;
    padding-block: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-on-dark-muted);
  }

  .mobile-nav__link[aria-current="page"] {
    color: var(--accent-cyan);
  }

  /* "Listen to Blur FM" row in the mobile menu — same card border/radius +
     quiet cyan-edge hover as the rest of the surface family. */
  .mobile-nav__listen {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    margin-top: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--card-border);
    border-radius: var(--card-radius);
    background-color: color-mix(in srgb, var(--accent-cyan) 8%, transparent);
    color: var(--text-on-dark);
    transition:
      border-color var(--transition),
      background-color var(--transition);
  }

  .mobile-nav__listen:hover {
    border-color: color-mix(in srgb, var(--accent-cyan) 40%, transparent);
    background-color: color-mix(in srgb, var(--accent-cyan) 12%, transparent);
  }

  .mobile-nav__listen-glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: var(--bg-dark);
    background-color: var(--accent-cyan);
  }

  .mobile-nav__listen-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .mobile-nav__listen-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--accent-cyan);
  }

  @media (max-width: 720px) {
    .header__nav {
      display: none;
    }

    .header__toggle {
      display: flex;
    }
  }
</style>
