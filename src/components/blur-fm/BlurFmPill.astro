---
/**
 * BlurFmPill — the compact, in-header Blur FM player. Reads as a small,
 * intentional module that belongs to the header, not a floating media widget:
 * cover art, a two-line track/artist stack, and a plain circular play/pause
 * control, all held in one subtle bordered surface.
 *
 * Colors adapt to the header's own state: on the dark/navy header the holder
 * stays a quiet dark card with a cyan control; on the cyan header (non-home
 * pages, or home scrolled past the hero) it blends into the bar instead —
 * transparent, navy text, a navy control — so it never out-contrasts the nav.
 * The artwork itself is unchanged in both states (see BlurFmPill ancestor
 * selectors keyed off `.header--home` / `.header--past-hero` in Header.astro).
 *
 * The track line scrolls in place when it overflows its width (calm
 * hold → scroll → hold → return loop, driven by the controller — see
 * runTrackMarquee in player.ts); it stays fully static when it fits. The
 * artist line never animates, always just truncates with an ellipsis.
 *
 * Desktop only; hidden at the mobile breakpoint. State is driven by the
 * player controller via [data-blurfm-toggle] / data-state / [data-blurfm-art]
 * / [data-blurfm-track-viewport] / [data-blurfm-track] / [data-blurfm-artist]
 * — no script of its own.
 */
import PlayPauseGlyph from "./PlayPauseGlyph.astro";
---

<div class="player">
  <div class="player__art" aria-hidden="true">
    <img
      class="player__art-img"
      data-blurfm-art
      alt=""
      width="44"
      height="44"
      loading="lazy"
    />
  </div>

  <div class="player__now" role="status" aria-live="polite" aria-label="Now playing on Blur FM">
    <span class="player__track" data-blurfm-track-viewport>
      <span class="player__track-text" data-blurfm-track></span>
    </span>
    <span class="player__artist" data-blurfm-artist></span>
  </div>

  <button
    class="player__toggle"
    type="button"
    data-blurfm-toggle
    data-state="paused"
    aria-pressed="false"
    aria-label="Play Blur FM"
  >
    <PlayPauseGlyph size={14} />
  </button>
</div>

<style>
  .player {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2) var(--space-1) var(--space-1);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius);
    /* Dark-header default: a quiet dark card, close to the header's own bg. */
    background-color: var(--bg-dark);
    transition:
      border-color var(--transition),
      background-color var(--transition);
  }

  .player:hover {
    border-color: color-mix(in srgb, var(--accent-cyan) 35%, transparent);
  }

  /* Slightly firmer border while live/loading — still subtle. */
  .player:has([data-state="playing"]),
  .player:has([data-state="loading"]) {
    border-color: color-mix(in srgb, var(--accent-cyan) 40%, transparent);
  }

  /* Cover art tile — a real, visible square, not a favicon. Unchanged
     regardless of header state; it's the one constant visual accent. */
  .player__art {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background-color: var(--bg-dark-2);
  }

  .player__art-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--transition-slow);
  }

  .player__art-img.is-ready {
    opacity: 1;
  }

  /* Fixed width so the holder never reflows as metadata changes. Two-line
     stack, vertically centered against the artwork. */
  .player__now {
    flex: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1px;
    width: clamp(100px, 9vw, 140px);
    min-width: 0;
  }

  /* Track title — the primary line. A plain clipping viewport; the inner
     text span is what the controller slides when the title overflows it. */
  .player__track {
    display: block;
    overflow: hidden;
    white-space: nowrap;
  }

  /* Soft right-edge fade — only while genuinely overflowing (JS-toggled),
     so short titles stay perfectly crisp with no mask at all. */
  .player__track.is-scrolling {
    -webkit-mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(100% - 12px),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      #000 0,
      #000 calc(100% - 12px),
      transparent 100%
    );
  }

  .player__track-text {
    display: inline-block;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: 1.25;
    color: var(--text-on-dark);
    transition: color var(--transition);
    will-change: transform;
  }

  /* Artist — secondary line: same size, lighter weight + lower contrast. */
  .player__artist {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    line-height: 1.25;
    color: var(--text-on-dark-muted);
    transition: color var(--transition);
  }

  /* Plain, clear circular control — no nested-pill treatment. */
  .player__toggle {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: var(--bg-dark);
    background-color: var(--accent-cyan);
    transition: background-color var(--transition);
  }

  .player__toggle:hover {
    background-color: var(--accent-cyan-hover);
  }

  /* Cyan header state (non-home pages, or home scrolled past the hero):
     blend into the bar instead of sitting on it as a dark card — transparent
     holder, navy text, and a navy (not cyan-on-cyan) control. */
  :global(:is(.header:not(.header--home), .header--home.header--past-hero))
    .player {
    background-color: transparent;
    border-color: color-mix(in srgb, var(--text-on-light) 20%, transparent);
  }

  :global(:is(.header:not(.header--home), .header--home.header--past-hero))
    .player:hover {
    border-color: color-mix(in srgb, var(--text-on-light) 40%, transparent);
  }

  :global(:is(.header:not(.header--home), .header--home.header--past-hero))
    .player:has([data-state="playing"]),
  :global(:is(.header:not(.header--home), .header--home.header--past-hero))
    .player:has([data-state="loading"]) {
    border-color: color-mix(in srgb, var(--text-on-light) 50%, transparent);
  }

  :global(:is(.header:not(.header--home), .header--home.header--past-hero))
    .player__track-text {
    color: var(--text-on-light);
  }

  :global(:is(.header:not(.header--home), .header--home.header--past-hero))
    .player__artist {
    color: var(--text-on-light-muted);
  }

  :global(:is(.header:not(.header--home), .header--home.header--past-hero))
    .player__toggle {
    color: var(--accent-cyan);
    background-color: var(--bg-dark);
  }

  :global(:is(.header:not(.header--home), .header--home.header--past-hero))
    .player__toggle:hover {
    background-color: var(--bg-dark-2);
  }

  /* Mobile: the chip yields to the menu row + bottom mini-player. */
  @media (max-width: 720px) {
    .player {
      display: none;
    }
  }
</style>
