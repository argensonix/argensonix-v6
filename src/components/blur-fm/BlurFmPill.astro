---
/**
 * BlurFmPill — a small, quiet "live status" chip on the right of the desktop
 * header. Reads as a secondary signal, not a media module: a compact circular
 * play/pause button, a very small ON AIR label, and a narrow fading now-playing
 * area whose marquee only animates when the track text overflows.
 *
 * Fixed widths keep the chip from reflowing when metadata changes. Desktop
 * only; hidden at the mobile breakpoint. State is driven by the player
 * controller via [data-blurfm-toggle] / data-state — no script of its own.
 */
import PlayPauseGlyph from "./PlayPauseGlyph.astro";
import NowPlayingMarquee from "./NowPlayingMarquee.astro";
---

<div class="pill">
  <button
    class="pill__toggle"
    type="button"
    data-blurfm-toggle
    data-state="paused"
    aria-pressed="false"
    aria-label="Play Blur FM"
  >
    <PlayPauseGlyph size={12} />
  </button>

  <span class="pill__label">
    <span class="pill__dot" aria-hidden="true"></span>
    On Air
  </span>

  <!-- Wrapper is owned by THIS component so its scoped width/size actually
       apply (Astro does not push a parent scope onto a child's root). -->
  <div class="pill__now">
    <NowPlayingMarquee />
  </div>
</div>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 30px;
    max-width: 260px;
    padding-inline: var(--space-1) var(--space-3);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-pill);
    background-color: color-mix(in srgb, var(--accent-cyan) 5%, transparent);
    transition: border-color var(--transition);
  }

  .pill:hover {
    border-color: color-mix(in srgb, var(--accent-cyan) 35%, transparent);
  }

  /* Slightly firmer border while live/loading — still subtle. */
  .pill:has([data-state="playing"]),
  .pill:has([data-state="loading"]) {
    border-color: color-mix(in srgb, var(--accent-cyan) 40%, transparent);
  }

  /* Compact circular play/pause button. */
  .pill__toggle {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    color: var(--accent-cyan);
    background-color: color-mix(in srgb, var(--accent-cyan) 14%, transparent);
    transition: background-color var(--transition);
  }

  .pill__toggle:hover {
    background-color: color-mix(in srgb, var(--accent-cyan) 24%, transparent);
  }

  .pill__label {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
  }

  .pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-cyan);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent-cyan) 55%, transparent);
  }

  /* Pulse the dot only while live. */
  .pill:has([data-state="playing"]) .pill__dot {
    animation: blurfm-pulse 1.8s ease-out infinite;
  }

  @keyframes blurfm-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent-cyan) 55%, transparent);
    }
    70% {
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent-cyan) 0%, transparent);
    }
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent-cyan) 0%, transparent);
    }
  }

  /* Narrow, fixed overflow area — track text never widens the chip.
     Quiet by design: small + muted so it reads as a secondary signal. */
  .pill__now {
    flex: none;
    width: clamp(110px, 12vw, 150px);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--text-on-dark-muted);
  }

  /* The marquee viewport fills the wrapper width set above. */
  .pill__now :global(.np-marquee) {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .pill:has([data-state="playing"]) .pill__dot {
      animation: none;
    }
  }

  /* Mobile: the chip yields to the menu row + bottom mini-player. */
  @media (max-width: 720px) {
    .pill {
      display: none;
    }
  }
</style>
