---
/**
 * CtaSection — shared closing call-to-action band (dark, gradient panel).
 * Copy defaults to the site-wide CTA; override via props if needed.
 */
import Button from "../ui/Button.astro";

interface Props {
  title?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title = "Let’s build something useful.",
  text = "Design, code and media for thoughtful digital projects.",
  ctaLabel = "Get in touch",
  ctaHref = "/contact",
} = Astro.props;
---

<section class="cta theme-dark section">
  <div class="container">
    <div class="cta__panel">
      <h2 class="cta__title">{title}</h2>
      <p class="cta__sub">{text}</p>
      <Button label={ctaLabel} href={ctaHref} uppercase />
    </div>
  </div>
</section>

<style>
  .cta__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: clamp(2.5rem, 6vw, 5rem) var(--space-6);
    border-radius: var(--radius-lg);
    text-align: center;
    background-image: linear-gradient(
      135deg,
      var(--bg-dark-card),
      var(--bg-dark-2)
    );
  }

  .cta__title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
  }

  .cta__sub {
    color: var(--muted);
    max-width: 44ch;
  }

  .cta__panel :global(.btn) {
    margin-top: var(--space-2);
  }
</style>
