---
/**
 * ProjectCard — flat project card (no heavy shadow).
 * Thumbnail (or graceful placeholder) + title + year + summary + tags.
 * If a link is provided the whole card becomes clickable via a stretched link;
 * externalUrl opens in a new tab. Filtering is handled by the parent, not here.
 */
import Tag from "./Tag.astro";

interface Props {
  title: string;
  year: string;
  summary: string;
  tags?: string[];
  thumbnail?: string;
  href?: string;
  externalUrl?: string;
  /** Drives the external-link indicator; see isExternal below */
  entryType?: string;
}

const {
  title,
  year,
  summary,
  tags = [],
  thumbnail,
  href,
  externalUrl,
  entryType,
} = Astro.props;

const link = externalUrl ?? href;
// External only when explicitly external or carrying an external URL — never
// for internal links / future detail pages.
const isExternal = entryType === "external" || Boolean(externalUrl);
const extraAttrs =
  isExternal && link ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<article
  class:list={["card", "project-card", link && "project-card--link"]}
>
  <div class="project-card__thumb">
    {
      thumbnail ? (
        <img src={thumbnail} alt={title} loading="lazy" decoding="async" />
      ) : (
        <span class="project-card__thumb-fallback" aria-hidden="true" />
      )
    }
  </div>

  <div class="project-card__body">
    <div class="project-card__row">
      <h3 class="project-card__title">
        {
          link ? (
            <a class="project-card__link" href={link} {...extraAttrs}>
              {title}
            </a>
          ) : (
            title
          )
        }
      </h3>
      <span class="project-card__year">{year}</span>
    </div>

    <p class="project-card__summary">{summary}</p>

    {
      tags.length > 0 && (
        <div class="project-card__tags">
          {tags.map((tag) => (
            <Tag label={tag} />
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  /* Layout only — surface, border, radius, shadow, transition and the
     focus-within ring all come from the shared .card base (global.css). */
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
  }

  /* Thumbnail / placeholder — taller 4:3 gives the cards more weight */
  .project-card__thumb {
    aspect-ratio: 4 / 3;
    background-color: color-mix(in srgb, var(--text-on-light) 10%, transparent);
  }

  .project-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .project-card__thumb-fallback {
    display: block;
    width: 100%;
    height: 100%;
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--card-pad);
    flex: 1;
  }

  .project-card__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .project-card__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
  }

  .project-card__link {
    color: inherit;
  }

  /* Stretched link: makes the whole card clickable (no inline icon) */
  .project-card--link .project-card__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  /* The whole-card ring (.card:focus-within) is the focus indicator here, so
     suppress the inner outline on the stretched link to avoid a double ring. */
  .project-card--link .project-card__link:focus-visible {
    outline: none;
  }

  .project-card__year {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
    white-space: nowrap;
  }

  .project-card__summary {
    color: var(--muted);
    font-size: var(--text-md);
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto; /* keep tags aligned to the card bottom; body gap sets rhythm */
  }

  /* Hover affordance only for linkable cards. Depth via a cyan edge + small
     lift + a quiet thumbnail zoom — no heavy shadow (design rule). */
  .project-card--link:hover {
    border-color: var(--accent-cyan);
    transform: translateY(var(--card-lift));
  }

  .project-card--link:hover .project-card__thumb img {
    transform: scale(1.03);
  }

  /* Motion is decoration here: hold the card still when reduced motion is asked. */
  @media (prefers-reduced-motion: reduce) {
    .project-card--link:hover {
      transform: none;
    }

    .project-card--link:hover .project-card__thumb img {
      transform: none;
    }
  }
</style>
