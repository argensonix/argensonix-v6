---
/**
 * EyebrowLabel — small mono uppercase label, e.g. "01 - MANIFESTO".
 * JetBrains Mono with the required 0.06em tracking.
 */
interface Props {
  text: string;
  theme?: "light" | "dark";
}

const { text, theme = "dark" } = Astro.props;
---

<span class:list={["eyebrow", `eyebrow--${theme}`]}>{text}</span>

<style>
  .eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.9375rem; /* 15px — clearly more present than the old 12px */
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }

  /* theme drives color so the label works outside a themed section too */
  .eyebrow--dark {
    color: var(--text-on-dark-muted);
  }

  .eyebrow--light {
    color: var(--text-on-light-muted);
  }
</style>
