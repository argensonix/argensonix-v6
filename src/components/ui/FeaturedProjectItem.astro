---
/**
 * FeaturedProjectItem — editorial, image-led entry for the homepage
 * "Selected projects" section. Image leads, name and a single line of copy
 * sit underneath it. Deliberately not a boxed card: no border, background
 * or shadow around the item itself.
 *
 * `image` is optional — omit it to render a labeled ImagePlaceholder at the
 * same 3:2 ratio, so the grid can be evaluated before final artwork exists.
 */
import ImagePlaceholder from "./ImagePlaceholder.astro";

interface Props {
  title: string;
  summary: string;
  href?: string;
  externalUrl?: string;
  entryType?: string;
  image?: string;
}

const { title, summary, href, externalUrl, entryType, image } = Astro.props;

const link = externalUrl ?? href;
const isExternal = entryType === "external" || Boolean(externalUrl);
const extraAttrs =
  isExternal && link ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<article class="featured-project">
  <div class="featured-project__media">
    {
      image ? (
        <img src={image} alt={title} loading="lazy" decoding="async" />
      ) : (
        <ImagePlaceholder label={title} />
      )
    }
  </div>

  <div class="featured-project__body">
    <h3 class="featured-project__title">
      {
        link ? (
          <a class="featured-project__link" href={link} {...extraAttrs}>
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    <p class="featured-project__summary">{summary}</p>
  </div>
</article>

<style>
  .featured-project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .featured-project__media img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .featured-project__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 46ch;
  }

  .featured-project__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
  }

  .featured-project__link {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition);
  }

  /* Stretched link: the whole item is the click target, title stays the
     accessible link text. Mirrors the ProjectCard pattern. */
  .featured-project__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .featured-project__link:hover {
    color: var(--accent-cyan);
  }

  /* The whole-item ring is the focus indicator, so suppress the inner
     outline on the stretched link to avoid a double ring. */
  .featured-project__link:focus-visible {
    outline: none;
  }

  .featured-project:has(.featured-project__link):focus-within {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
    border-radius: 3px;
  }

  .featured-project__summary {
    color: var(--muted);
    font-size: var(--text-md);
  }
</style>
