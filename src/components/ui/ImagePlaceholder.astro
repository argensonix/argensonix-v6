---
/**
 * ImagePlaceholder — production placeholder for a not-yet-final project
 * image. States the required export spec and overlays a 10%-inset safe-area
 * guide so grid/layout can be evaluated before final artwork exists.
 * Purely decorative: hidden from assistive tech, since the item's
 * accessible name comes from the project title next to it.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="image-placeholder" data-project={label} aria-hidden="true">
  <span class="image-placeholder__spec">1600 &times; 1067 px &mdash; 3:2</span>
  <!-- Safe-area guide: a temporary production reference, not part of the
       final design. Delete this .image-placeholder__safe-area element (or
       swap the whole component for a real <img>) once final artwork lands. -->
  <span class="image-placeholder__safe-area">
    <span class="image-placeholder__safe-area-label">SAFE AREA</span>
  </span>
</div>

<style>
  .image-placeholder {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px dashed var(--border-card);
    background-color: var(--bg-light-neutral);
    background-image: repeating-linear-gradient(
      -45deg,
      color-mix(in srgb, var(--text-on-light) 6%, transparent) 0,
      color-mix(in srgb, var(--text-on-light) 6%, transparent) 1px,
      transparent 1px,
      transparent 14px
    );
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-placeholder__spec {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--text-on-light-muted);
    background-color: var(--bg-light-neutral);
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border-card);
    border-radius: var(--radius-sm);
  }

  .image-placeholder__safe-area {
    position: absolute;
    inset: 10%;
    border: 1px dashed color-mix(in srgb, var(--accent-yellow) 70%, transparent);
    pointer-events: none;
  }

  .image-placeholder__safe-area-label {
    position: absolute;
    top: 0.4rem;
    left: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-mono);
    color: var(--text-on-light);
    background-color: var(--accent-yellow);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
  }
</style>
