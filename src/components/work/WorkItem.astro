---
import type { WorkItem } from "../../data/work";

interface Props {
  item: WorkItem;
  revealDelay?: string;
}

const { item, revealDelay = "1" } = Astro.props;
---

<li
  class="work-item"
  data-category={item.category}
  data-reveal
  data-reveal-delay={revealDelay}
>
  <article class="work-item__card card">

    <div class="work-item__thumb">
      <img
        src={item.thumbnail}
        alt={item.title}
        width="600"
        height="450"
        loading="lazy"
        class="work-item__img"
      />
      <div class="work-item__overlay">
        {item.url ? (
          <a
            href={item.url}
            class="work-item__overlay-link btn btn--primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            View project ↗
          </a>
        ) : (
          <span class="work-item__overlay-hint">Coming soon</span>
        )}
      </div>
    </div>

    <div class="work-item__info">
      <div class="work-item__meta">
        <span class="work-item__category">{item.category}</span>
        {item.year && <span class="work-item__year">{item.year}</span>}
      </div>
      <h3 class="work-item__title">{item.title}</h3>
      {item.description && (
        <p class="work-item__desc">{item.description}</p>
      )}
    </div>

  </article>
</li>

<style>
  .work-item {
    display: block;
  }

  .work-item__card {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Thumbnail */
  .work-item__thumb {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-alt);
  }

  .work-item__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .work-item__card:hover .work-item__img {
    transform: scale(1.05);
  }

  /* Overlay — uses color-mix() to derive transparency from the token */
  .work-item__overlay {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--dark-blue) 75%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition);
  }

  .work-item__card:hover .work-item__overlay {
    opacity: 1;
  }

  .work-item__overlay-hint {
    color: color-mix(in srgb, var(--ink-on-brand) 70%, transparent);
    font-size: var(--text-sm);
    font-style: italic;
  }

  /* Info */
  .work-item__info {
    padding: var(--space-4) var(--space-6) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .work-item__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .work-item__category {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-blue);
  }

  .work-item__year {
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .work-item__title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .work-item__desc {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.55;
  }
</style>
