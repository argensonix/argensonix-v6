---
import WorkItem from "./WorkItem.astro";
import { workCategories } from "../../data/work";
import type { WorkItem as WorkItemType } from "../../data/work";

interface Props {
  items: WorkItemType[];
}

const { items } = Astro.props;
---

<div class="work-grid-section">

  <!-- Category filter tabs -->
  <div class="work-filter" role="tablist" aria-label="Filter work by category">
    {workCategories.map((cat) => (
      <button
        class:list={["work-filter__btn", { "work-filter__btn--active": cat === "All" }]}
        data-filter={cat}
        role="tab"
        aria-selected={cat === "All" ? "true" : "false"}
        type="button"
      >
        {cat}
      </button>
    ))}
  </div>

  <!-- Grid -->
  <ul class="work-grid" role="list" aria-label="Work portfolio">
    {items.map((item, i) => (
      <WorkItem item={item} revealDelay={String((i % 3) + 1)} />
    ))}
  </ul>

  <!-- Empty state (hidden by default) -->
  <p class="work-grid__empty" hidden>No projects in this category yet.</p>

</div>

<!-- Filter script — minimal, no dependencies -->
<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".work-filter__btn");
  const workItems = document.querySelectorAll<HTMLElement>(".work-item");
  const emptyState = document.querySelector<HTMLElement>(".work-grid__empty");

  function applyFilter(category: string) {
    let visible = 0;

    workItems.forEach((item) => {
      const itemCat = item.dataset.category ?? "";
      const show = category === "All" || itemCat === category;
      item.style.display = show ? "" : "none";
      if (show) visible++;
    });

    if (emptyState) emptyState.hidden = visible > 0;

    filterBtns.forEach((btn) => {
      const active = btn.dataset.filter === category;
      btn.classList.toggle("work-filter__btn--active", active);
      btn.setAttribute("aria-selected", active ? "true" : "false");
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      applyFilter(btn.dataset.filter ?? "All");
    });
  });
</script>

<style>
  /* Filter tabs */
  .work-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-12);
  }

  .work-filter__btn {
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--line-strong);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: var(--surface);
    cursor: pointer;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }

  .work-filter__btn:hover {
    border-color: var(--brand-blue);
    color: var(--brand-blue);
  }

  .work-filter__btn--active {
    background: var(--brand-blue);
    border-color: var(--brand-blue);
    color: var(--ink-on-brand);
  }

  /* Grid */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .work-grid__empty {
    text-align: center;
    padding: var(--space-16);
    color: var(--ink-muted);
    font-size: var(--text-md);
  }

  /* Responsive */
  @media (max-width: 960px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
