---
import type { Article } from "../../data/articles";

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<section class="articles section" aria-labelledby="articles-heading">
  <div class="container">

    <div class="articles__header" data-reveal>
      <div>
        <span class="eyebrow">From the blog</span>
        <h2 class="articles__title h-lg" id="articles-heading">
          Latest articles
        </h2>
      </div>
      <a
        href="https://nico.ar"
        class="btn btn--outline"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visit nico.ar blog"
      >
        Visit nico.ar ↗
      </a>
    </div>

    <ul class="articles__list" role="list">
      {articles.map((article, i) => (
        <li
          class="articles__item"
          data-reveal
          data-reveal-delay={String(Math.min(i + 1, 5))}
        >
          <a
            href={article.url}
            class="articles__link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="articles__meta">
              <time class="articles__date" datetime={article.date}>
                {formatDate(article.date)}
              </time>
            </div>
            <div class="articles__body">
              <h3 class="articles__item-title">{article.title}</h3>
              {article.excerpt && (
                <p class="articles__excerpt">{article.excerpt}</p>
              )}
            </div>
            <span class="articles__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .articles {
    background: var(--surface);
  }

  .articles__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
    flex-wrap: wrap;
  }

  .articles__title {
    color: var(--dark-blue);
    margin-top: var(--space-2);
  }

  /* Section header reveals as one unit */
  .articles__header {
    /* Defined below — don't remove this comment anchor */
  }

  /* List */
  .articles__list {
    display: flex;
    flex-direction: column;
  }

  .articles__item {
    border-top: 1px solid var(--line);
  }

  .articles__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .articles__link {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-6) 0;
    transition: color var(--transition);
  }

  .articles__link:hover {
    color: var(--brand-blue);
  }

  .articles__link:hover .articles__arrow {
    transform: translateX(4px);
    color: var(--brand-blue);
  }

  .articles__date {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .articles__item-title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: var(--space-1);
    transition: color var(--transition);
  }

  .articles__link:hover .articles__item-title {
    color: var(--brand-blue);
  }

  .articles__excerpt {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  .articles__arrow {
    font-size: var(--text-lg);
    color: var(--ink-soft);
    transition: transform var(--transition), color var(--transition);
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .articles__link {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      gap: var(--space-2) var(--space-4);
    }

    .articles__meta {
      grid-column: 1;
      grid-row: 1;
    }

    .articles__body {
      grid-column: 1;
      grid-row: 2;
    }

    .articles__arrow {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
</style>
