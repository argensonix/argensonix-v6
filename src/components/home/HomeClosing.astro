---
/**
 * HomeClosing — the Home-only closing panel: CTA and footer merged into one
 * full-width dark band.
 *
 * Three clear tiers on one container grid, nothing competing:
 *   1. the poster-scale statement (it IS the CTA — no button follows it);
 *   2. the footer row — "A" mark + nav left, social icons right;
 *   3. the meta row — hairline across the container, © left, made-in right.
 *
 * The cyan "useful." bookends the hero's cyan "design," at the top of the
 * page. Home only: every other page gets the compact global Footer alone
 * (no large CTA band).
 *
 * NOTE: the GitHub URL is a placeholder — confirm the real handle.
 */
const navLinks = [
  { label: "Projects", href: "/projects" },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: "/contact" },
];

const socialLinks = [
  { label: "GitHub", href: "https://github.com/argensonix", icon: "github" },
  {
    label: "LinkedIn",
    href: "https://ar.linkedin.com/in/nicolaszicarelli/",
    icon: "linkedin",
  },
  { label: "Email", href: "mailto:nico@argensonix.com.ar", icon: "email" },
];
---

<footer class="closing theme-dark section-atmos">
  <div class="container">
    <h2 class="closing__title">
      Let’s build<br />
      <span class="closing__ghost">something</span><br />
      <span class="closing__accent">useful.</span>
    </h2>

    <div class="closing__footer-main">
      <div class="closing__brand-nav">
        <a class="closing__mark" href="/" aria-label="Argensonix — home">
          <img src="/img/a-logo-positive.svg" alt="" width="51" height="52" />
        </a>

        <nav aria-label="Footer">
          <ul class="closing__nav" role="list">
            {
              navLinks.map((link) => (
                <li>
                  <a class="closing__nav-link" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <ul class="closing__socials" role="list">
        {
          socialLinks.map((link) => {
            const external = link.href.startsWith("http");
            return (
              <li>
                <a
                  class="closing__social-link"
                  href={link.href}
                  aria-label={link.label}
                  {...(external
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  {link.icon === "github" && (
                    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.16-.02-2.1-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"
                      />
                    </svg>
                  )}
                  {link.icon === "linkedin" && (
                    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                      />
                    </svg>
                  )}
                  {link.icon === "email" && (
                    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
                      <path
                        fill="currentColor"
                        d="M2 5.5C2 4.67 2.67 4 3.5 4h17c.83 0 1.5.67 1.5 1.5v13c0 .83-.67 1.5-1.5 1.5h-17C2.67 20 2 19.33 2 18.5v-13Zm2.2.5L12 11.6 19.8 6H4.2ZM20 7.3l-7.4 5.3a1 1 0 0 1-1.2 0L4 7.3V18h16V7.3Z"
                      />
                    </svg>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    <div class="closing__meta">
      <p class="closing__fine">&copy; 1999&ndash;2026 Argensonix Multimedia</p>
      <p class="closing__fine">Made in Buenos Aires &middot; v6.0</p>
    </div>
  </div>
</footer>

<style>
  /* The band opens right after the (equally dark) blog section; the bloom is
     anchored in the air to the right of the statement, never under it. */
  .closing {
    padding-block: clamp(4rem, 8vw, 7rem) var(--space-8);
    --atmos-x: 72%;
    --atmos-y: 30%;
    --atmos-strength: 9%;
    --atmos-grid: 0.25;
  }

  /* ── Tier 1: the statement ────────────────────────────────── */
  /* Poster scale, left-aligned, air on the right. Its bottom margin is the
     only thing separating it from the footer rows — it never pushes them. */
  .closing__title {
    margin-bottom: clamp(3rem, 7vw, 5.5rem);
    font-size: clamp(3rem, 8.5vw, 7rem);
    font-weight: var(--weight-extrabold);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    text-wrap: normal;
  }

  /* The ghosted middle line: stepped back, still legible. */
  .closing__ghost {
    color: color-mix(in srgb, var(--text-on-dark) 18%, transparent);
  }

  /* Bookends the hero's cyan "design," — pulled slightly toward the navy so
     it states rather than shouts at this size. */
  .closing__accent {
    color: color-mix(in srgb, var(--accent-cyan) 85%, var(--bg-dark));
  }

  /* ── Tier 2: footer row — brand+nav left, socials right ───── */
  .closing__footer-main {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
  }

  .closing__brand-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  /* The mark sits at half presence; full when it's actually being used. */
  .closing__mark {
    display: inline-flex;
    opacity: 0.5;
    transition: opacity var(--transition);
  }

  .closing__mark:hover,
  .closing__mark:focus-visible {
    opacity: 0.9;
  }

  .closing__mark img {
    height: 52px;
    width: auto;
  }

  .closing__nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .closing__nav-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    transition: color var(--transition);
  }

  .closing__nav-link:hover {
    color: var(--text-on-dark);
  }

  /* One horizontal row, always — never a stack. */
  .closing__socials {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .closing__social-link {
    display: inline-flex;
    color: var(--text-on-dark-muted);
    transition: color var(--transition);
  }

  .closing__social-link:hover {
    color: var(--accent-cyan);
  }

  /* ── Tier 3: meta row ─────────────────────────────────────── */
  /* The hairline belongs to this row (its top border), so it always spans
     exactly the container — never a loose line. */
  .closing__meta {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-4);
    border-top: 1px solid var(--rule);
    padding-top: var(--space-5);
  }

  .closing__fine {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--muted);
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 640px) {
    .closing__footer-main {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .closing__meta {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
