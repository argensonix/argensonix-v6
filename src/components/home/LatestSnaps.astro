---
import type { Snap } from "../../data/snaps";

interface Props {
  snaps: Snap[];
}

const { snaps } = Astro.props;
---

<section class="snaps section" aria-labelledby="snaps-heading">
  <div class="container">

    <div class="snaps__header" data-reveal>
      <div>
        <span class="eyebrow">Photography</span>
        <h2 class="snaps__title h-lg" id="snaps-heading">
          Latest snaps
        </h2>
      </div>
      <a
        href="https://www.lodelnico.com"
        class="btn btn--outline"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visit lodelnico.com photography portfolio"
      >
        See all photos ↗
      </a>
    </div>

    <ul class="snaps__grid" role="list" aria-label="Photo gallery">
      {snaps.map((snap, i) => (
        <li
          class="snaps__item"
          data-reveal
          data-reveal-delay={String(Math.min(i + 1, 5))}
        >
          {snap.url ? (
            <a
              href={snap.url}
              class="snaps__link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={snap.alt}
            >
              <img
                src={snap.src}
                alt={snap.alt}
                width="400"
                height="400"
                loading="lazy"
                class="snaps__img"
              />
            </a>
          ) : (
            <div class="snaps__link">
              <img
                src={snap.src}
                alt={snap.alt}
                width="400"
                height="400"
                loading="lazy"
                class="snaps__img"
              />
            </div>
          )}
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .snaps {
    background: var(--bg);
  }

  .snaps__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
    flex-wrap: wrap;
  }

  .snaps__title {
    color: var(--dark-blue);
    margin-top: var(--space-2);
  }

  /* Grid */
  .snaps__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-3);
  }

  .snaps__item {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--surface-alt);
  }

  .snaps__link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .snaps__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow), opacity var(--transition);
  }

  .snaps__link:hover .snaps__img {
    transform: scale(1.05);
    opacity: 0.92;
  }

  /* Blue-tinted shadow on hover — per CLAUDE.md */
  .snaps__item:hover {
    box-shadow: var(--shadow-blue);
  }

  /* Responsive */
  @media (max-width: 960px) {
    .snaps__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    /* Show only first 3 snaps on small screens — hide extras */
    .snaps__item:nth-child(n+4) {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .snaps__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .snaps__item:nth-child(n+3) {
      display: none;
    }
  }
</style>
