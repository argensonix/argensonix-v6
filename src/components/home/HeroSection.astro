---
// No props — hero copy is editorial, kept inline for now
---

<section class="hero" aria-label="Hero">

  <!-- Layered background depth elements -->
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__bg-glow hero__bg-glow--1"></div>
    <div class="hero__bg-glow hero__bg-glow--2"></div>
    <div class="hero__bg-accent"></div>
  </div>

  <div class="hero__inner container">

    <div class="hero__content">
      <h1 class="hero__headline h-display hero-animate hero-animate--1">
        Design that
        <br />
        <em class="hero__headline-em">moves things</em>
        <br />
        forward.
      </h1>
      <p class="hero__lead lead hero-animate hero-animate--2">
        Web, animation, brand identity and multimedia production.
        Built with care since 1999.
      </p>
      <div class="hero__actions hero-animate hero-animate--3">
        <a href="/work" class="btn btn--primary">See the work</a>
        <a href="/contact" class="btn btn--outline hero__btn-outline">Get in touch</a>
      </div>
    </div>

    <div class="hero__visual hero-animate hero-animate--visual" aria-hidden="true">
      <!-- Decorative ring behind the block -->
      <div class="hero__visual-ring"></div>
      <div class="hero__visual-block">
        <!-- Replace with a real image or video loop -->
        <div class="hero__placeholder">
          <span class="hero__placeholder-letter">A</span>
          <!-- Floating accent dots -->
          <span class="hero__dot hero__dot--1"></span>
          <span class="hero__dot hero__dot--2"></span>
          <span class="hero__dot hero__dot--3"></span>
        </div>
      </div>
      <!-- Year badge — offset below the block -->
      <div class="hero__badge">
        <span class="hero__badge-year">1999</span>
        <span class="hero__badge-label">Est. Buenos Aires</span>
      </div>
    </div>

  </div>
</section>

<style>
  /* ── Shell ────────────────────────────────────────────────── */
  .hero {
    position: relative;
    background: var(--surface);
    padding-top: var(--space-24);
    padding-bottom: var(--space-32);
    overflow: hidden;
    /* Top accent stripe */
    border-top: 3px solid var(--brand-blue);
  }

  /* ── Background depth layers ─────────────────────────────── */
  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  /* Soft radial glows — color from brand tokens */
  .hero__bg-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }

  .hero__bg-glow--1 {
    width: 600px;
    height: 400px;
    top: -100px;
    right: -80px;
    background: radial-gradient(ellipse, rgba(0, 183, 255, 0.09) 0%, transparent 70%);
  }

  .hero__bg-glow--2 {
    width: 400px;
    height: 300px;
    bottom: -60px;
    left: -60px;
    background: radial-gradient(ellipse, rgba(33, 52, 106, 0.06) 0%, transparent 70%);
  }

  /* Diagonal accent line top-right */
  .hero__bg-accent {
    position: absolute;
    top: 0;
    right: 0;
    width: 38%;
    height: 100%;
    background: linear-gradient(
      180deg,
      rgba(0, 183, 255, 0.035) 0%,
      transparent 60%
    );
    clip-path: polygon(30% 0%, 100% 0%, 100% 100%, 0% 100%);
  }

  /* ── Layout grid ─────────────────────────────────────────── */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
    min-height: 560px;
  }

  /* ── Content ─────────────────────────────────────────────── */
  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero__headline {
    color: var(--dark-blue);
  }

  .hero__headline-em {
    font-style: normal;
    color: var(--brand-blue);
    /* Slight underline emphasis */
    text-decoration: underline;
    text-decoration-color: rgba(0, 183, 255, 0.35);
    text-underline-offset: 6px;
    text-decoration-thickness: 3px;
  }

  .hero__lead {
    max-width: 400px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  /* Outline button inverted on hero surface */
  .hero__btn-outline {
    border-color: var(--dark-blue);
    color: var(--dark-blue);
  }

  .hero__btn-outline:hover {
    border-color: var(--brand-blue);
    color: var(--brand-blue);
  }

  /* ── Entry animations (above-the-fold — CSS, no IO needed) ── */
  .hero-animate {
    opacity: 0;
    animation: heroEnter var(--transition-enter) var(--ease-out) forwards;
  }

  .hero-animate--1 { animation-delay: 80ms; }
  .hero-animate--2 { animation-delay: 240ms; }
  .hero-animate--3 { animation-delay: 380ms; }
  .hero-animate--visual {
    animation-name: heroSlideRight;
    animation-delay: 200ms;
  }

  /* ── Visual block ─────────────────────────────────────────── */
  .hero__visual {
    position: relative;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  /* Decorative ring behind the image block */
  .hero__visual-ring {
    position: absolute;
    top: 50%;
    right: -24px;
    transform: translateY(-50%);
    width: 520px;
    height: 520px;
    border-radius: 50%;
    border: 1px solid rgba(0, 183, 255, 0.12);
    pointer-events: none;
  }

  .hero__visual-block {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    /* Blue-tinted shadow for depth */
    box-shadow: var(--shadow-blue-lg);
  }

  /* Placeholder — remove when real asset is added */
  .hero__placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      var(--brand-blue) 0%,
      var(--dark-blue) 100%
    );
  }

  .hero__placeholder-letter {
    font-family: var(--font-display);
    font-size: 11rem;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.1);
    line-height: 1;
    user-select: none;
    letter-spacing: -0.05em;
  }

  /* Floating accent dots inside placeholder */
  .hero__dot {
    position: absolute;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }

  .hero__dot--1 {
    width: 80px;
    height: 80px;
    top: 20%;
    right: 15%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .hero__dot--2 {
    width: 40px;
    height: 40px;
    bottom: 25%;
    left: 12%;
    background: rgba(255, 255, 255, 0.12);
  }

  .hero__dot--3 {
    width: 14px;
    height: 14px;
    top: 30%;
    left: 30%;
    background: rgba(255, 255, 255, 0.3);
  }

  /* ── Year badge ──────────────────────────────────────────── */
  .hero__badge {
    position: absolute;
    bottom: -16px;
    left: -8px;
    z-index: 2;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 2px;
    box-shadow: var(--shadow-blue-sm);
  }

  .hero__badge-year {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--dark-blue);
    line-height: 1;
  }

  .hero__badge-label {
    font-size: var(--text-xs);
    color: var(--ink-soft);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: var(--space-16);
    }

    .hero__visual {
      justify-content: flex-start;
    }

    .hero__visual-block {
      max-width: 100%;
    }

    .hero__visual-ring {
      display: none;
    }

    .hero__badge {
      bottom: -12px;
      left: 0;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding-top: var(--space-16);
      padding-bottom: var(--space-24);
    }

    .hero__actions {
      flex-direction: column;
    }

    .hero__actions .btn {
      width: 100%;
      justify-content: center;
    }

    .hero__bg-accent {
      display: none;
    }
  }
</style>
