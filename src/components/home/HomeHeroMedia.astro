---
/** Existing square footage becomes an edge-to-edge field. Keep the subject
 * exposed on the right and reserve a dark printing area for the headline.
 * The orbital line crosses the footage; it no longer outlines a container. */
---

<div class="hero-media" aria-hidden="true">
  <div class="hero-media__picture" aria-hidden="true">
    <video
      class="hero-media__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/home-hero-poster.webp"
    >
      <source src="/home-hero.webm" type="video/webm" />
      <source src="/home-hero.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="hero-media__graphics" aria-hidden="true">
    <div class="hero-media__orbit"><span></span></div>
    <div class="hero-media__ticks"></div>
  </div>
</div>

<style>
  .hero-media {
    display: block;
    position: absolute;
    inset: 0;
    background: var(--bg-dark);
  }

  .hero-media__picture {
    position: absolute;
    inset: 0;
    /* One directional ink wash, no blur, glow or color grading. */
    mask-image: linear-gradient(90deg, transparent, #000 68%);
  }

  .hero-media__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 52%;
  }

  .hero-media__picture::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--bg-dark), transparent 75%);
  }

  .hero-media__graphics {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-media__orbit {
    position: absolute;
    width: min(78vw, 1100px);
    aspect-ratio: 1;
    top: -28%;
    right: -14%;
    border: 1px solid color-mix(in srgb, var(--text-on-dark) 24%, transparent);
    border-radius: 50%;
    animation: orbit 80s linear infinite;
  }

  .hero-media__orbit span {
    position: absolute;
    left: 14.645%;
    top: 14.645%;
    width: var(--space-2);
    height: var(--space-2);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--accent-cyan);
  }

  .hero-media__ticks {
    position: absolute;
    top: var(--space-8);
    right: max(var(--container-pad), calc((100% - var(--container-max)) / 2 + var(--container-pad)));
    width: var(--space-16);
    height: var(--space-3);
    background: repeating-linear-gradient(90deg,
      var(--text-on-dark-muted) 0 1px, transparent 1px 12px);
  }

  @keyframes orbit {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 640px) {
    .hero-media__picture {
      mask-image: none;
    }

    .hero-media__video {
      object-position: 62% center;
    }

    .hero-media__picture::after {
      /* The restored copy is centered, so protect its full height on mobile. */
      background: linear-gradient(0deg,
        var(--bg-dark),
        color-mix(in srgb, var(--bg-dark) 65%, transparent));
    }

    .hero-media__orbit {
      width: 135%;
      top: -20%;
      right: -50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media__orbit { animation: none; }
  }
</style>
