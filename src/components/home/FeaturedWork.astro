---
import { workItems } from "../../data/work";

const featured = workItems.filter((item) => item.featured).slice(0, 3);
---

<section class="featured section" aria-labelledby="featured-heading">
  <div class="container">

    <div class="featured__header" data-reveal>
      <div>
        <span class="eyebrow">Selected work</span>
        <h2 class="featured__title h-lg" id="featured-heading">
          A few things<br />we're proud of.
        </h2>
      </div>
      <a href="/work" class="btn btn--outline featured__cta">
        See all work →
      </a>
    </div>

    <ul class="featured__grid" role="list">
      {featured.map((item, i) => (
        <li
          class="featured-card card"
          data-reveal
          data-reveal-delay={String(i + 1)}
        >
          {item.url ? (
            <a href={item.url} class="featured-card__link" target="_blank" rel="noopener noreferrer" aria-label={item.title}>
              <div class="featured-card__thumb">
                <img
                  src={item.thumbnail}
                  alt={item.title}
                  width="600"
                  height="450"
                  loading="lazy"
                  class="featured-card__img"
                />
              </div>
              <div class="featured-card__body">
                <div class="featured-card__meta">
                  <span class="featured-card__cat">{item.category}</span>
                  {item.year && <span class="featured-card__year">{item.year}</span>}
                </div>
                <h3 class="featured-card__title">{item.title}</h3>
                {item.description && (
                  <p class="featured-card__desc">{item.description}</p>
                )}
              </div>
            </a>
          ) : (
            <div class="featured-card__link">
              <div class="featured-card__thumb">
                <img
                  src={item.thumbnail}
                  alt={item.title}
                  width="600"
                  height="450"
                  loading="lazy"
                  class="featured-card__img"
                />
              </div>
              <div class="featured-card__body">
                <div class="featured-card__meta">
                  <span class="featured-card__cat">{item.category}</span>
                  {item.year && <span class="featured-card__year">{item.year}</span>}
                </div>
                <h3 class="featured-card__title">{item.title}</h3>
                {item.description && (
                  <p class="featured-card__desc">{item.description}</p>
                )}
              </div>
            </div>
          )}
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .featured {
    background: var(--bg);
  }

  .featured__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
    flex-wrap: wrap;
  }

  .featured__title {
    color: var(--dark-blue);
    margin-top: var(--space-2);
  }

  .featured__cta {
    flex-shrink: 0;
    margin-bottom: var(--space-2);
  }

  .featured__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  /* Card */
  .featured-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .featured-card__thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-alt);
  }

  .featured-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .featured-card:hover .featured-card__img {
    transform: scale(1.04);
  }

  .featured-card__body {
    padding: var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .featured-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .featured-card__cat {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-blue);
  }

  .featured-card__year {
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  .featured-card__title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--ink);
    transition: color var(--transition);
  }

  .featured-card:hover .featured-card__title {
    color: var(--brand-blue);
  }

  .featured-card__desc {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .featured__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .featured__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
